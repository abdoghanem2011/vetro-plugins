rn;\n        }\n        probeHardwareCapture(function (res) {\n            if (!screenshotWaiters) return;\n            if (!res || !res.hwAvailable || hwFailedRuntime) {\n                runWaylandScreenshotCapture();\n                return;\n            }\n            var dll;\n            try {\n                dll = ensureHelperMaterialized();\n            } catch (err) {\n                runWaylandScreenshotCapture();\n                return;\n            }\n            var abi = res.hwAbi || ((process.arch === 'arm' || process.arch === 'ia32') ? 'ilp32' : 'lp64-int');\n            var shotOut = path.join(hwRuntimeDir, 'shot_' + Date.now().toString(36) + '_' + Math.random().toString(36).slice(2, 8) + '.jpg');\n            var cmd = 'DOTNET_ROLL_FORWARD=Major ' + shQuote(dotnetPath) + ' ' + shQuote(dll) +\n                ' --oneshot-hd --abi ' + abi + ' --quality 92 --out ' + shQuote(shotOut);\n            try {\n                ctx.execute(cmd, 8000).then(function (r) {\n                    if (!screenshotWaiters) {\n                        unlinkFile(shotOut);\n                        return;\n                    }\n                    if (r && r.exit_code === 0) {\n                        fs.stat(shotOut, function (err, stat) {\n                            if (!err && stat && stat.size > 1000) {\n                                readAndServeShot(shotOut, 'image/jpeg');\n                                return;\n                            }\n                            unlinkFile(shotOut);\n                            runWaylandScreenshotCapture();\n                        });\n                    } else {\n                        unlinkFile(shotOut);\n                        runWaylandScreenshotCapture();\n                    }\n                }, function () {\n                    unlinkFile(shotOut);\n                    runWaylandScreenshotCapture();\n                });\n            } catch (e) {\n                unlinkFile(shotOut);\n                runWaylandScreenshotCapture();\n            }\n        });\n    }\n\n    function getClientIp(req) {\n        var ip = '';\n        if (req && req.socket && req.socket.remoteAddress) {\n            ip = String(req.socket.remoteAddress);\n        } else if (req && req.connection && req.connection.remoteAddress) {\n            ip = String(req.connection.remoteAddress);\n        }\n        return ip.replace(/^::ffff:/i, '');\n    }\n\n    function lookupArpMac(ip) {\n        if (!ip || !/^\\d{1,3}(\\.\\d{1,3}){3}$/.test(ip)) return null;\n        try {\n            var arp = fs.readFileSync(arpPath, 'utf8');\n            var lines = arp.split('\\n');\n            for (var i = 1; i < lines.length; i++) {\n                var cols = lines[i].replace(/^\\s+|\\s+$/g, '').split(/\\s+/);\n                if (cols.length >= 4 && cols[0] === ip && cols[2] !== '0x0') {\n                    var mac = cols[3].toLowerCase();\n                    if (/^([0-9a-f]{2}:){5}[0-9a-f]{2}$/.test(mac) && mac !== '00:00:00:00:00:00') {\n                        return mac;\n                    }\n                }\n            }\n        } catch (e) {}\n        return null;\n    }\n\n    function ensureTokenSalt(cfg) {\n        if (cfg && typeof cfg.salt === 'string' && /^[0-9a-f]{32,64}$/.test(cfg.salt)) {\n            return cfg.salt;\n        }\n        var salt = crypto.randomBytes(16).toString('hex');\n        if (cfg && typeof cfg === 'object') {\n            cfg.salt = salt;\n            try { saveCfg(cfg); } catch (e) {}\n        }\n        return salt;\n    }\n\n    function getClientIdentity(req, cfg, createSalt) {\n        var salt = (cfg && typeof cfg.salt === 'string' && /^[0-9a-f]{32,64}$/.test(cfg.salt))\n            ? cfg.salt\n            : (createSalt ? ensureTokenSalt(cfg) : null);\n        if (!salt) return null;\n        var ip = getClientIp(req);\n        var mac = lookupArpMac(ip);\n        var raw = mac ? ('mac:' + mac) : (ip ? ('ip:' + ip) : 'local');\n        var key = crypto.createHmac('sha256', salt).update(raw).digest('hex').slice(0, 16);\n        return { key: key, tag: key.slice(0, 4) };\n    }\n\n    function hasAnySavedToken(cfg) {\n        if (!cfg || typeof cfg !== 'object') return false;\n        if (typeof cfg.token === 'string' && cfg.token.length > 0) return true;\n        if (cfg.tokens && typeof cfg.tokens === 'object' && !Array.isArray(cfg.tokens)) {\n            var keys = Object.keys(cfg.tokens);\n            for (var i = 0; i < keys.length; i++) {\n                var v = cfg.tokens[keys[i]];\n                if (typeof v === 'string' && v.length > 0) return true;\n            }\n        }\n        return false;\n    }\n\n    function getTokenForClient(cfg, req, createSalt) {\n        var id = getClientIdentity(req, cfg, createSalt);\n        var tokens = (cfg && cfg.tokens && typeof cfg.tokens === 'object' && !Array.isArray(cfg.tokens)) ? cfg.tokens : null;\n        if (id && tokens && typeof tokens[id.key] === 'string' && tokens[id.key].length > 0) {\n            return { token: tokens[id.key], deviceTag: id.tag, legacy: false };\n        }\n        if (cfg && typeof cfg.token === 'string' && cfg.token.length > 0 && (!tokens || Object.keys(tokens).length === 0)) {\n            return { token: cfg.token, deviceTag: id ? id.tag : null, legacy: true };\n        }\n        return { token: null, deviceTag: id ? id.tag : null, legacy: false };\n    }\n\n    return {\n        start: function () {\n            loadStreamConfig();\n            page = loadPage(ctx);\n        },\n\n        stop: function () {\n            stopHold();\n            clearMouseQueue();\n            stopMouseHold(true);\n            invalidateMouseNodeCache();\n            closeAllStreamClients();\n            stopStreamPipeline();\n            clearScreenshotWaiters();\n            page = null;\n        },\n\n        status: function () {\n            return { paired: hasAnySavedToken(getCfg()) };\n        },\n\n        route: function (req, res, sub) {\n\n            // GET api/ui\n            if (sub === 'ui' && req.method === 'GET') {\n                if (!page) page = loadPage(ctx);\n                res.writeHead(200, { 'content-type': 'text/html; charset=utf-8', 'cache-control': 'no-store' });\n                res.end(page || '');\n                return true;\n            }\n\n            // GET api/status\n            if (sub === 'status' && req.method === 'GET') {\n                var cfg0 = getCfg();\n                var tok0 = getTokenForClient(cfg0, req, false);\n                res.writeHead(200, {\n                    'content-type': 'application/json',\n                    'cache-control': 'no-store'\n                });\n                res.end(JSON.stringify({\n                    ok: true,\n                    paired: !!tok0.token,\n                    tvIp: getTvIp(),\n                    stream: getStreamConfig(),\n                    capture: getCaptureStatusSnapshot()\n                }));\n                return true;\n            }\n\n            // GET api/token — returns caller device's own Samsung Remote pairing token and anonymous tag\n            if (sub === 'token' && req.method === 'GET') {\n                var cfgTok = getCfg();\n                var tokInfo = getTokenForClient(cfgTok, req, true);\n                res.writeHead(200, {\n                    'content-type': 'application/json',\n                    'cache-control': 'no-store'\n                });\n                res.end(JSON.stringify({\n                    ok: true,\n                    token: tokInfo.token,\n                    deviceTag: tokInfo.deviceTag,\n                    legacy: tokInfo.legacy || undefined\n                }));\n                return true;\n            }\n\n            // POST api/savetoken\n            if (sub === 'savetoken' && req.method === 'POST') {\n                readJson(req, 4096, function (err, parsed) {\n                    if (err) {\n                        res.writeHead(400, { 'content-type': 'application/json' });\n                        res.end(JSON.stringify({ ok: false, error: err.message }));\n                        return;\n                    }\n                    try {\n                        var isSave = (typeof parsed.token === 'string' && parsed.token.length > 0 && parsed.token.length < 256);\n                        var isReset = (!isSave && !!(parsed.reset || parsed.token === null));\n                        if (isSave || isReset) {\n                            var c2 = getCfg();\n                            var devId = getClientIdentity(req, c2, isSave);\n                            var srcMap = (c2.tokens && typeof c2.tokens === 'object' && !Array.isArray(c2.tokens)) ? c2.tokens : {};\n                            var map = {};\n                            var existingKeys = Object.keys(srcMap);\n                            for (var kIdx = 0; kIdx < existingKeys.length; kIdx++) {\n                                var kName = existingKeys[kIdx];\n                                if (typeof srcMap[kName] === 'string' && srcMap[kName].length > 0) {\n                                    map[kName] = srcMap[kName];\n                                }\n                            }\n                            var changed = false;\n                            if (isSave && devId && devId.key) {\n                                if (map[devId.key] !== parsed.token || c2.token !== undefined || existingKeys[existingKeys.length - 1] !== devId.key) {\n                                    delete map[devId.key];\n                                    map[devId.key] = parsed.token;\n                                    var keys = Object.keys(map);\n                                    while (keys.length > MAX_TOKEN_DEVICES) {\n                                        delete map[keys.shift()];\n                                    }\n                                    c2.tokens = map;\n                                    delete c2.token;\n                                    changed = true;\n                                }\n                            } else if (isReset) {\n                                if (devId && devId.key && Object.prototype.hasOwnProperty.call(map, devId.key)) {\n                                    delete map[devId.key];\n                                    if (Object.keys(map).length > 0) {\n                                        c2.tokens = map;\n                                    } else {\n                                        delete c2.tokens;\n                                    }\n                                    changed = true;\n                                }\n                                if (Object.prototype.hasOwnProperty.call(c2, 'token')) {\n                                    delete c2.token;\n                                    changed = true;\n                                }\n                            }\n                            if (changed) saveCfg(c2);\n                        }\n                        res.writeHead(200, { 'content-type': 'application/json' });\n                        res.end(JSON.stringify({ ok: true }));\n                    } catch (e) {\n                        res.writeHead(500, { 'content-type': 'application/json' });\n                        res.end(JSON.stringify({ ok: false, error: 'failed to save configuration' }));\n                    }\n                });\n                return true;\n            }\n\n            // POST api/key — inject single keysym or manage hold action\n            if (sub === 'key' && req.method === 'POST') {\n                readJson(req, 4096, function (err, parsed) {\n                    if (err) {\n                        res.writeHead(400, { 'content-type': 'application/json' });\n                        res.end(JSON.stringify({ ok: false, error: err.message }));\n                        return;\n                    }\n                    var key = parsed.key;\n                    var action = parsed.action;\n                    var isShift = !!parsed.shift;\n                    var isCtrl = !!parsed.ctrl;\n\n                    if (!key || typeof key !== 'string' || !/^[A-Za-z0-9_]+$/.test(key)) {\n                        res.writeHead(400, { 'content-type': 'application/json' });\n                        res.end(JSON.stringify({ ok: false, error: 'invalid key name' }));\n                        return;\n                    }\n\n                    if (action === 'down') {\n                        startHold(key);\n                        res.writeHead(200, { 'content-type': 'application/json' });\n                        res.end(JSON.stringify({ ok: true, holding: true }));\n                        return;\n                    }\n\n                    if (action === 'up') {\n                        stopHold();\n                        res.writeHead(200, { 'content-type': 'application/json' });\n                        res.end(JSON.stringify({ ok: true, holding: false }));\n                        return;\n                    }\n\n                    // Single tap / click\n                    stopHold();\n\n                    if (/^[A-Z]$/.test(key)) {\n                        key = key.toLowerCase();\n                        isShift = true;\n                    }\n\n                    var cmd;\n                    if (isCtrl) {\n                        cmd = 'sh -c \"/usr/bin/input_keyevent Control_L down; /usr/bin/input_keyevent ' + key + '; /usr/bin/input_keyevent Control_L up\"';\n                    } else if (isShift) {\n                        cmd = 'sh -c \"/usr/bin/input_keyevent Shift_L down; /usr/bin/input_keyevent ' + key + '; /usr/bin/input_keyevent Shift_L up\"';\n                    } else {\n                        cmd = '/usr/bin/input_keyevent ' + key;\n                    }\n\n                    ctx.execute(cmd, 5000).then(function (r) {\n                        res.writeHead(200, { 'content-type': 'application/json' });\n                        res.end(JSON.stringify({ ok: r.exit_code === 0, stderr: r.stderr }));\n                    }, function (e) {\n                        res.writeHead(200, { 'content-type': 'application/json' });\n                        res.end(JSON.stringify({ ok: false, error: e.message }));\n                    });\n                });\n                return true;\n            }\n\n            // POST api/type — inject ASCII string via input_keyevent sequence\n            if (sub === 'type' && req.method === 'POST') {\n                readJson(req, 4096, function (err, parsed) {\n                    if (err) {\n                        res.writeHead(400, { 'content-type': 'application/json' });\n                        res.end(JSON.stringify({ ok: false, error: err.message }));\n                        return;\n                    }\n                    var text = parsed.text;\n                    if (!text || typeof text !== 'string') {\n                        res.writeHead(400, { 'content-type': 'application/json' });\n                        res.end(JSON.stringify({ ok: false, error: 'missing text' }));\n                        return;\n                    }\n                    var truncated = false;\n                    if (text.length > 200) {\n                        text = text.slice(0, 200);\n                        truncated = true;\n                    }\n                    var cmds = [];\n                    var dropped = [];\n                    for (var i = 0; i < text.length; i++) {\n                        var ch = text[i];\n                        if (/^[a-z0-9]$/.test(ch)) {\n                            cmds.push('/usr/bin/input_keyevent ' + ch);\n                        } else if (/^[A-Z]$/.test(ch)) {\n                            cmds.push('/usr/bin/input_keyevent Shift_L down; /usr/bin/input_keyevent ' + ch.toLowerCase() + '; /usr/bin/input_keyevent Shift_L up');\n                        } else if (SHIFT_MAP[ch]) {\n                            cmds.push('/usr/bin/input_keyevent Shift_L down; /usr/bin/input_keyevent ' + SHIFT_MAP[ch] + '; /usr/bin/input_keyevent Shift_L up');\n                        } else if (LATIN_MAP[ch]) {\n                            cmds.push('/usr/bin/input_keyevent ' + LATIN_MAP[ch]);\n                        } else {\n                            dropped.push(ch);\n                        }\n                    }\n                    if (cmds.length === 0) {\n                        res.writeHead(200, { 'content-type': 'application/json' });\n                        res.end(JSON.stringify({\n                            ok: true,\n                            dropped: dropped.length > 0 ? dropped : undefined,\n                            truncated: truncated || undefined\n                        }));\n                        return;\n                    }\n                    var cmd = \"sh -c '\" + cmds.join('; sleep 0.04; ') + \"'\";\n                    ctx.execute(cmd, 15000).then(function (r) {\n                        res.writeHead(200, { 'content-type': 'application/json' });\n                        res.end(JSON.stringify({\n                            ok: r.exit_code === 0,\n                            dropped: dropped.length > 0 ? dropped : undefined,\n                            truncated: truncated || undefined,\n                            stderr: r.stderr\n                        }));\n                    }, function (e) {\n                        res.writeHead(200, { 'content-type': 'application/json' });\n                        res.end(JSON.stringify({ ok: false, error: e.message }));\n                    });\n                });\n                return true;\n            }\n\n            // POST api/mouse — fast fallback cursor jump/click/drag and scroll wheel via Enlightenment D-Bus\n            if (sub === 'mouse' && req.method === 'POST') {\n                readJson(req, 4096, function (err, parsed) {\n                    if (err) {\n                        res.writeHead(400, { 'content-type': 'application/json' });\n                        res.end(JSON.stringify({ ok: false, error: err.message }));\n                        return;\n                    }\n                    var action = String(parsed.action || 'click');\n                    var node = findMouseNode();\n                    if (!node) {\n                        res.writeHead(200, { 'content-type': 'application/json' });\n                        res.end(JSON.stringify({ ok: false, error: 'no mouse device node' }));\n                        return;\n                    }\n                    var hasXY = (typeof parsed.x === 'number' && typeof parsed.y === 'number' && isFinite(parsed.x) && isFinite(parsed.y));\n                    var x = hasXY ? Math.max(0, Math.min(1919, Math.round(parsed.x))) : 0;\n                    var y = hasXY ? Math.max(0, Math.min(1079, Math.round(parsed.y))) : 0;\n                    var dx = 0;\n                    var dy = 0;\n                    var w = -1;\n\n                    if ((action === 'move' || action === 'click' || action === 'dblclick' || action === 'rightclick' || action === 'down') && hasXY) {\n                        // valid positional action\n                    } else if (action === 'clickInPlace' || action === 'up') {\n                        // valid non-positional action\n                    } else if (action === 'drag') {\n                        dx = Math.max(-2000, Math.min(2000, Math.round(Number(parsed.dx) || 0)));\n                        dy = Math.max(-2000, Math.min(2000, Math.round(Number(parsed.dy) || 0)));\n                        if (dx === 0 && dy === 0) {\n                            res.writeHead(200, { 'content-type': 'application/json' });\n                            res.end(JSON.stringify({ ok: true }));\n                            return;\n                        }\n                    } else if (action === 'wheel') {\n                        w = Math.max(-5, Math.min(5, Math.round(Number(parsed.delta) || 0)));\n                        if (w === 0) w = -1;\n                    } else {\n                        res.writeHead(400, { 'content-type': 'application/json' });\n                        res.end(JSON.stringify({ ok: false, error: 'invalid mouse action' }));\n                        return;\n                    }\n\n                    var tail = mouseQueue.length > 0 ? mouseQueue[mouseQueue.length - 1] : null;\n                    if (action === 'drag' && tail && tail.action === 'drag' && tail.node === node) {\n                        tail.dx = Math.max(-2000, Math.min(2000, tail.dx + dx));\n                        tail.dy = Math.max(-2000, Math.min(2000, tail.dy + dy));\n                        res.writeHead(200, { 'content-type': 'application/json' });\n                        res.end(JSON.stringify({ ok: true }));\n                        return;\n                    }\n                    if (mouseBusy && mouseQueue.length >= MAX_MOUSE_QUEUE) {\n                        res.writeHead(503, { 'content-type': 'application/json' });\n                        res.end(JSON.stringify({ ok: false, error: 'mouse queue full' }));\n                        return;\n                    }\n                    mouseQueue.push({\n                        node: node,\n                        action: action,\n                        hasXY: hasXY,\n                        x: x,\n                        y: y,\n                        dx: dx,\n                        dy: dy,\n                        w: w,\n                        res: res\n                    });\n                    drainMouseQueue();\n                });\n                return true;\n            }\n\n            // POST api/stream_preset — configure live MJPEG stream preset and JPEG quality\n            if (sub === 'stream_preset' && req.method === 'POST') {\n                readJson(req, 4096, function (err, parsed) {\n                    if (err) {\n                        res.writeHead(400, { 'content-type': 'application/json' });\n                        res.end(JSON.stringify({ ok: false, error: err.message }));\n                        return;\n                    }\n                    var rawPreset = parsed.preset || parsed.mode;\n                    var hasPreset = (typeof rawPreset === 'string' &&\n                        Object.prototype.hasOwnProperty.call(STREAM_PRESETS, rawPreset));\n                    var hasQuality = isFiniteQuality(parsed.quality);\n                    if (!hasPreset && !hasQuality) {\n                        res.writeHead(400, { 'content-type': 'application/json' });\n                        res.end(JSON.stringify({ ok: false, error: 'invalid preset or quality' }));\n                        return;\n                    }\n                    var cfgOut = applyStreamConfig({\n                        preset: hasPreset ? rawPreset : undefined,\n                        quality: hasQuality ? Number(parsed.quality) : undefined\n                    }, true);\n                    res.writeHead(200, {\n                        'content-type': 'application/json',\n                        'cache-control': 'no-store'\n                    });\n                    res.end(JSON.stringify({\n                        ok: true,\n                        preset: cfgOut.preset,\n                        width: cfgOut.width,\n                        height: cfgOut.height,\n                        quality: cfgOut.quality\n                    }));\n                });\n                return true;\n            }\n\n            // POST api/capture_mode — switch between automatic HW capture and forced Wayland capture\n            if (sub === 'capture_mode' && req.method === 'POST') {\n                readJson(req, 4096, function (err, parsed) {\n                    if (err) {\n                        res.writeHead(400, { 'content-type': 'application/json' });\n                        res.end(JSON.stringify({ ok: false, error: err.message }));\n                        return;\n                    }\n                    var nextMode = parsed && parsed.mode;\n                    if (nextMode !== 'auto' && nextMode !== 'wayland') {\n                        res.writeHead(400, { 'content-type': 'application/json' });\n                        res.end(JSON.stringify({ ok: false, error: 'invalid capture mode' }));\n                        return;\n                    }\n                    var prevMode = captureMode;\n                    captureMode = nextMode;\n                    if (captureMode === 'auto') {\n                        hwFailedRuntime = false;\n                        if (hwProbe.probed && !hwProbe.hwAvailable) {\n                            hwProbe.probed = false;\n                        }\n                    }\n                    try {\n                        var cfgCap = getCfg();\n                        cfgCap.captureMode = captureMode;\n                        saveCfg(cfgCap);\n                    } catch (e) {}\n\n                    if (prevMode !== captureMode) {\n                        lastFrame = null;\n                        lastFrameWidth = 0;\n                        lastFrameHeight = 0;\n                        lastFrameTime = 0;\n                        if (streamProcRunning) {\n                            if (streamClients.length > 0) {\n                                scheduleStreamRestart(true);\n                            } else {\n                                stopStreamPipeline(false);\n                            }\n                        }\n                    }\n                    res.writeHead(200, {\n                        'content-type': 'application/json',\n                        'cache-control': 'no-store'\n                    });\n                    res.end(JSON.stringify({\n                        ok: true,\n                        capture: getCaptureStatusSnapshot()\n                    }));\n                });\n                return true;\n            }\n\n            // GET api/stream — persistent low-latency MJPEG or length-prefixed binary live stream\n            if (sub === 'stream' && req.method === 'GET') {\n                if (streamClients.length >= MAX_STREAM_CLIENTS) {\n                    res.writeHead(503, {\n                        'content-type': 'application/json',\n                        'cache-control': 'no-store'\n                    });\n                    res.end(JSON.stringify({ ok: false, error: 'too many stream viewers' }));\n                    return true;\n                }\n                var isBinFormat = /[?&]format=bin(?:&|$)/.test(String(req.url || ''));\n                res.writeHead(200, {\n                    'content-type': isBinFormat ? 'application/octet-stream' : 'multipart/x-mixed-replace; boundary=--frame',\n                    'cache-control': 'no-cache, no-store, must-revalidate',\n                    'pragma': 'no-cache',\n                    'connection': 'close'\n                });\n                if (res.socket && res.socket.setNoDelay) res.socket.setNoDelay(true);\n                var client = {\n                    res: res,\n                    format: isBinFormat ? 'bin' : 'mjpeg',\n                    busy: false,\n                    lastSendTime: 0,\n                    lastWriteOk: Date.now(),\n                    closed: false\n                };\n                streamClients.push(client);\n                if (streamKillTimer) {\n                    clearTimeout(streamKillTimer);\n                    streamKillTimer = null;\n                }\n                startStreamPipeline();\n                if (lastFrame && (Date.now() - lastFrameTime < 1500)) {\n                    var initPacket = buildClientFramePacket(\n                        client.format,\n                        lastFrame,\n                        lastFrameWidth || streamWidth,\n                        lastFrameHeight || streamHeight\n                    );\n                    writeStreamClient(client, initPacket);\n                }\n                var onDisconnect = function () {\n                    try {\n                        removeStreamClient(client);\n                    } catch (e) {}\n                };\n                req.on('close', onDisconnect);\n                req.on('error', onDisconnect);\n                res.on('close', onDisconnect);\n                res.on('error', onDisconnect);\n                return true;\n            }\n\n            // GET api/screenshot — captures crisp 1080p JPEG via Wayland (or Enlightenment WM PNG fallback)\n            if (sub === 'screenshot' && req.method === 'GET') {\n                if (screenshotWaiters) {\n                    screenshotWaiters.push(res);\n                    return true;\n                }\n                screenshotWaiters = [res];\n                runScreenshotCapture();\n                return true;\n            }\n\n            return false;\n        }\n    };\n};\n","ui.html":"<!DOCTYPE html>\r\n<html lang=\"en\">\r\n<head>\r\n<meta charset=\"utf-8\">\r\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\r\n<title>Keyboard &amp; Remote</title>\r\n<style>\r\n:root {\r\n  --bg: #0f1115;\r\n  --surface: #181b21;\r\n  --raised: #20242c;\r\n  --border: #2c323d;\r\n  --text: #e6edf3;\r\n  --muted: #8b949e;\r\n  --action: #58a6ff;\r\n  --action-hover: #79b8ff;\r\n  --danger: #f85149;\r\n  --danger-hover: #ff7b72;\r\n  --danger-soft: rgba(248, 81, 73, .12);\r\n  --danger-line: rgba(248, 81, 73, .35);\r\n  --warn: #d29922;\r\n  --warn-soft: rgba(210, 153, 34, .12);\r\n  --warn-line: rgba(210, 153, 34, .35);\r\n  --success: #3fb950;\r\n  --link: #58a6ff;\r\n  --focus: #388bfd;\r\n  --r: 8px;\r\n  --font: -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, Helvetica, Arial, sans-serif;\r\n  --s1: 4px; --s2: 8px; --s3: 12px; --s4: 16px; --s5: 20px;\r\n  --fs-s: .85rem; --fs-m: .95rem; --fs-l: 1.1rem;\r\n}\r\n\r\n* { box-sizing: border-box; margin: 0; padding: 0; }\r\nbody {\r\n  font-family: var(--font);\r\n  background: var(--bg);\r\n  color: var(--text);\r\n  padding: var(--s3);\r\n  font-size: var(--fs-m);\r\n  line-height: 1.4;\r\n  -webkit-font-smoothing: antialiased;\r\n}\r\n\r\n.container {\r\n  max-width: 1200px;\r\n  margin: 0 auto;\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: var(--s3);\r\n}\r\n\r\n.app-layout {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: var(--s3);\r\n}\r\n\r\n@media (min-width: 860px) {\r\n  .app-layout {\r\n    display: grid;\r\n    grid-template-columns: minmax(320px, 1.25fr) minmax(280px, 1fr);\r\n    gap: var(--s3);\r\n    align-items: start;\r\n  }\r\n}\r\n\r\n.col-main, .col-side {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: var(--s3);\r\n}\r\n\r\n.box {\r\n  background: var(--surface);\r\n  border: 1px solid var(--border);\r\n  border-radius: var(--r);\r\n  padding: var(--s3);\r\n}\r\n\r\n.box-header {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 4px;\r\n  margin-bottom: var(--s2);\r\n}\r\n.box-title-row {\r\n  display: flex;\r\n  justify-content: space-between;\r\n  align-items: center;\r\n  width: 100%;\r\n  gap: var(--s2);\r\n}\r\n.box-title-clickable {\r\n  cursor: pointer;\r\n  user-select: none;\r\n}\r\n.box-title-row h2 {\r\n  font-size: var(--fs-l);\r\n  font-weight: 600;\r\n  margin: 0;\r\n  white-space: nowrap;\r\n}\r\n.header-notice {\r\n  color: var(--muted);\r\n  font-size: var(--fs-s);\r\n  margin: 0;\r\n  line-height: 1.3;\r\n}\r\n.box-header-actions {\r\n  display: inline-flex;\r\n  align-items: center;\r\n  gap: var(--s2);\r\n  flex-shrink: 0;\r\n  max-width: 65%;\r\n}\r\n\r\n.status-badge {\r\n  font-size: .8rem;\r\n  font-weight: 500;\r\n  padding: 3px 10px;\r\n  border-radius: 12px;\r\n  background: var(--raised);\r\n  border: 1px solid var(--border);\r\n  display: inline-flex;\r\n  align-items: center;\r\n  gap: 6px;\r\n  white-space: nowrap;\r\n  color: var(--muted);\r\n  max-width: 220px;\r\n  overflow: hidden;\r\n  text-overflow: ellipsis;\r\n  box-sizing: border-box;\r\n}\r\n.status-badge.ok {\r\n  background: rgba(127, 203, 160, .14);\r\n  border-color: rgba(127, 203, 160, .4);\r\n  color: #7fcba0;\r\n}\r\n.status-badge.warn {\r\n  background: var(--warn-soft);\r\n  border-color: var(--warn-line);\r\n  color: var(--warn);\r\n}\r\n.status-badge.err {\r\n  background: var(--danger-soft);\r\n  border-color: var(--danger-line);\r\n  color: var(--danger);\r\n}\r\n.status-badge.busy {\r\n  background: rgba(143, 186, 255, .14);\r\n  border-color: rgba(143, 186, 255, .4);\r\n  color: var(--link);\r\n}\r\n.status-badge.is-retryable {\r\n  cursor: pointer;\r\n  touch-action: manipulation;\r\n  user-select: none;\r\n  -webkit-user-select: none;\r\n  transition: filter .12s, transform .05s;\r\n}\r\n.status-badge.is-retryable:hover { filter: brightness(1.15); }\r\n.status-badge.is-retryable:active { transform: scale(.97); }\r\n.status-badge.is-retryable:focus-visible { outline: 2px solid var(--focus); outline-offset: 1px; }\r\n\r\n.btn-collapse {\r\n  width: 28px;\r\n  height: 28px;\r\n  min-height: 28px;\r\n  padding: 0;\r\n  border-radius: var(--r);\r\n  background: var(--raised);\r\n  border: 1px solid var(--border);\r\n  color: var(--muted);\r\n  display: inline-flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  cursor: pointer;\r\n  transition: background .15s, color .15s;\r\n}\r\n.btn-collapse:hover {\r\n  background: var(--border);\r\n  color: var(--text);\r\n}\r\n.btn-collapse svg {\r\n  width: 14px;\r\n  height: 14px;\r\n  fill: none;\r\n  stroke: currentColor;\r\n  stroke-width: 2.5;\r\n  stroke-linecap: round;\r\n  stroke-linejoin: round;\r\n  transition: transform .2s ease;\r\n}\r\n\r\n#box-screen.is-collapsed .btn-collapse svg,\r\n#box-keyboard.is-collapsed .btn-collapse svg,\r\n#box-playback.is-collapsed .btn-collapse svg {\r\n  transform: rotate(-90deg);\r\n}\r\n#box-screen.is-collapsed #screen-body,\r\n#box-keyboard.is-collapsed #keyboard-body,\r\n#box-playback.is-collapsed #playback-body {\r\n  display: none;\r\n}\r\n#box-screen.is-collapsed,\r\n#box-keyboard.is-collapsed,\r\n#box-playback.is-collapsed {\r\n  padding-bottom: var(--s2);\r\n}\r\n#box-screen.is-collapsed .box-header,\r\n#box-keyboard.is-collapsed .box-header,\r\n#box-playback.is-collapsed .box-header {\r\n  margin-bottom: 0;\r\n}\r\n#box-screen.is-collapsed .header-notice,\r\n#box-keyboard.is-collapsed .header-notice,\r\n#box-playback.is-collapsed .header-notice {\r\n  display: none;\r\n}\r\n\r\n.notice {\r\n  color: var(--muted);\r\n  font-size: var(--fs-s);\r\n  margin-bottom: var(--s2);\r\n}\r\n.kbd {\r\n  display: inline-block;\r\n  padding: 1px 5px;\r\n  background: var(--raised);\r\n  border: 1px solid var(--border);\r\n  border-radius: 4px;\r\n  font-family: ui-monospace, SFMono-Regular, \"SF Mono\", Menlo, Consolas, monospace;\r\n  font-size: .8rem;\r\n  color: var(--text);\r\n}\r\n.sec {\r\n  font-size: .75rem;\r\n  letter-spacing: .08em;\r\n  text-transform: uppercase;\r\n  color: var(--muted);\r\n  margin-top: var(--s3);\r\n  margin-bottom: var(--s2);\r\n}\r\n\r\nbutton {\r\n  background: var(--raised);\r\n  border: 1px solid var(--border);\r\n  color: var(--text);\r\n  font-family: inherit;\r\n  font-size: var(--fs-s);\r\n  font-weight: 500;\r\n  padding: var(--s2) var(--s3);\r\n  border-radius: var(--r);\r\n  cursor: pointer;\r\n  display: inline-flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  gap: var(--s1);\r\n  min-height: 40px;\r\n  touch-action: manipulation;\r\n  user-select: none;\r\n  -webkit-user-select: none;\r\n  transition: background .12s, border-color .12s, transform .05s;\r\n}\r\nbutton:hover { background: #262b34; border-color: #3b4250; }\r\nbutton:active { background: #1c2027; transform: scale(.98); }\r\nbutton:focus-visible { outline: 2px solid var(--focus); outline-offset: 1px; }\r\n\r\nbutton.primary {\r\n  background: var(--action);\r\n  color: #0b1118;\r\n  border-color: var(--action);\r\n  font-weight: 600;\r\n}\r\nbutton.primary:hover { background: var(--action-hover); border-color: var(--action-hover); }\r\n\r\nbutton.danger {\r\n  background: var(--danger-soft);\r\n  color: var(--danger);\r\n  border-color: var(--danger-line);\r\n}\r\nbutton.danger:hover { background: rgba(248, 81, 73, .22); }\r\n\r\n.input-row {\r\n  display: flex;\r\n  gap: var(--s2);\r\n  align-items: stretch;\r\n  margin-bottom: var(--s2);\r\n}\r\n.input-row input {\r\n  flex: 1;\r\n  background: var(--bg);\r\n  border: 1px solid var(--border);\r\n  border-radius: var(--r);\r\n  color: var(--text);\r\n  font-family: inherit;\r\n  font-size: var(--fs-m);\r\n  padding: var(--s2) var(--s3);\r\n  min-height: 40px;\r\n  min-width: 0;\r\n}\r\n.input-row input:focus { outline: 2px solid var(--focus); outline-offset: -1px; }\r\n.input-btns {\r\n  display: flex;\r\n  gap: var(--s1);\r\n}\r\n\r\n#cert-banner {\r\n  display: none;\r\n  background: var(--warn-soft);\r\n  border: 1px solid var(--warn-line);\r\n  border-radius: var(--r);\r\n  padding: var(--s3);\r\n  margin-bottom: var(--s3);\r\n  font-size: var(--fs-s);\r\n}\r\n.cert-url-bar {\r\n  display: flex;\r\n  gap: var(--s1);\r\n  margin-bottom: var(--s2);\r\n}\r\n.cert-url-bar input {\r\n  flex: 1;\r\n  background: var(--bg);\r\n  border: 1px solid var(--border);\r\n  border-radius: var(--r);\r\n  color: var(--text);\r\n  font-size: .8rem;\r\n  padding: 4px 8px;\r\n  font-family: ui-monospace, SFMono-Regular, \"SF Mono\", Menlo, Consolas, monospace;\r\n}\r\n.cert-btn-bar {\r\n  display: flex;\r\n  flex-wrap: wrap;\r\n  gap: var(--s1);\r\n}\r\n.cert-btn-bar button, .cert-btn-bar a button {\r\n  min-height: 32px;\r\n  padding: 4px 10px;\r\n  font-size: .8rem;\r\n}\r\n\r\n.dpad-cluster {\r\n  display: grid;\r\n  grid-template-columns: repeat(3, 1fr);\r\n  gap: var(--s2);\r\n  max-width: 340px;\r\n  margin: var(--s2) auto var(--s3);\r\n}\r\n.dpad-cluster button {\r\n  height: 48px;\r\n  font-size: var(--fs-m);\r\n}\r\n.dpad-ok {\r\n  font-weight: 700 !important;\r\n}\r\n\r\n.rocker-section {\r\n  display: grid;\r\n  grid-template-columns: 1fr 1fr 1fr;\r\n  gap: var(--s2);\r\n  margin-bottom: var(--s3);\r\n  max-width: 340px;\r\n  margin-left: auto;\r\n  margin-right: auto;\r\n  align-items: stretch;\r\n}\r\n.rocker-pill {\r\n  display: flex;\r\n  flex-direction: column;\r\n  background: var(--bg);\r\n  border: 1px solid var(--border);\r\n  border-radius: var(--r);\r\n  padding: var(--s1);\r\n  gap: var(--s1);\r\n  align-items: stretch;\r\n}\r\n.rocker-pill button {\r\n  height: 40px;\r\n  padding: 0;\r\n  font-size: var(--fs-m);\r\n}\r\n.rocker-tag {\r\n  font-size: .7rem;\r\n  font-weight: 600;\r\n  color: var(--muted);\r\n  text-align: center;\r\n  padding: 2px 0;\r\n  letter-spacing: .05em;\r\n}\r\n.center-stack {\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: var(--s2);\r\n  justify-content: space-between;\r\n  height: 100%;\r\n}\r\n.center-stack button {\r\n  flex: 1;\r\n  min-height: 40px;\r\n  font-size: var(--fs-s);\r\n}\r\n\r\n.grid-4 {\r\n  display: grid;\r\n  grid-template-columns: repeat(2, 1fr);\r\n  gap: var(--s2);\r\n}\r\n@media (min-width: 480px) {\r\n  .grid-4 { grid-template-columns: repeat(4, 1fr); }\r\n}\r\n.grid-4 button {\r\n  height: 40px;\r\n  font-size: var(--fs-s);\r\n}\r\n\r\n.numpad {\r\n  display: grid;\r\n  grid-template-columns: repeat(3, 1fr);\r\n  gap: var(--s2);\r\n  max-width: 260px;\r\n  margin: var(--s2) auto 0;\r\n}\r\n.numpad button {\r\n  height: 44px;\r\n  font-size: var(--fs-l);\r\n  font-weight: 600;\r\n}\r\n\r\n.media-grid {\r\n  display: grid;\r\n  grid-template-columns: repeat(3, 1fr);\r\n  gap: var(--s2);\r\n}\r\n.media-grid button {\r\n  height: 42px;\r\n  font-size: var(--fs-s);\r\n}\r\n\r\n.color-grid {\r\n  display: grid;\r\n  grid-template-columns: repeat(2, 1fr);\r\n  gap: var(--s2);\r\n}\r\n@media (min-width: 480px) {\r\n  .color-grid { grid-template-columns: repeat(4, 1fr); }\r\n}\r\n.color-grid button {\r\n  height: 40px;\r\n  font-size: var(--fs-s);\r\n}\r\n.btn-red { border-left: 4px solid #f85149; }\r\n.btn-green { border-left: 4px solid #3fb950; }\r\n.btn-yellow { border-left: 4px solid #d29922; }\r\n.btn-blue { border-left: 4px solid #58a6ff; }\r\n\r\n.screen-stage {\r\n  width: 100%;\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n}\r\n.screen-frame {\r\n  width: 100%;\r\n  aspect-ratio: 16 / 9;\r\n  background: #000;\r\n  border-radius: var(--r);\r\n  border: 1px solid var(--border);\r\n  overflow: hidden;\r\n  position: relative;\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  user-select: none;\r\n  -webkit-user-select: none;\r\n}\r\n.screen-frame.has-image {\r\n  cursor: crosshair;\r\n  touch-action: none;\r\n}\r\n.screen-frame img, .screen-frame canvas {\r\n  width: 100%;\r\n  height: 100%;\r\n  object-fit: contain;\r\n  display: none;\r\n  pointer-events: none;\r\n}\r\n#tv-cursor {\r\n  position: absolute;\r\n  width: 20px;\r\n  height: 20px;\r\n  margin-left: -10px;\r\n  margin-top: -10px;\r\n  border-radius: 50%;\r\n  border: 2px solid #58a6ff;\r\n  background: rgba(88, 166, 255, .24);\r\n  box-shadow: 0 0 0 1.5px rgba(0, 0, 0, .82), 0 0 10px rgba(88, 166, 255, .55);\r\n  pointer-events: none;\r\n  display: none;\r\n  z-index: 4;\r\n  transition: transform .12s ease, border-color .12s ease, background .12s ease;\r\n}\r\n#tv-cursor::after {\r\n  content: \"\";\r\n  position: absolute;\r\n  left: 50%;\r\n  top: 50%;\r\n  width: 4px;\r\n  height: 4px;\r\n  margin: -2px 0 0 -2px;\r\n  border-radius: 50%;\r\n  background: #fff;\r\n}\r\n#tv-cursor.is-holding {\r\n  border-color: #d29922;\r\n  background: rgba(210, 153, 34, .42);\r\n  transform: scale(1.38);\r\n  box-shadow: 0 0 0 2px rgba(0, 0, 0, .85), 0 0 14px rgba(210, 153, 34, .85);\r\n}\r\n.click-ripple {\r\n  position: absolute;\r\n  width: 24px;\r\n  height: 24px;\r\n  margin-left: -12px;\r\n  margin-top: -12px;\r\n  border-radius: 50%;\r\n  border: 2px solid #58a6ff;\r\n  pointer-events: none;\r\n  z-index: 3;\r\n  animation: tvRipple .42s ease-out forwards;\r\n}\r\n.click-ripple.ripple-alt {\r\n  border-color: #3fb950;\r\n}\r\n@keyframes tvRipple {\r\n  0% { transform: scale(.45); opacity: .95; }\r\n  100% { transform: scale(2.35); opacity: 0; }\r\n}\r\n#dpad-overlay {\r\n  position: absolute;\r\n  top: 0;\r\n  right: 0;\r\n  bottom: 0;\r\n  left: 0;\r\n  pointer-events: none;\r\n  display: none;\r\n  z-index: 2;\r\n}\r\n.screen-frame.has-image.is-dpad-mode #dpad-overlay {\r\n  display: block;\r\n}\r\n.dpad-zone-center {\r\n  position: absolute;\r\n  left: 34%;\r\n  top: 28%;\r\n  width: 32%;\r\n  height: 44%;\r\n  border: 2px dashed rgba(255, 255, 255, .52);\r\n  border-radius: 14px;\r\n  background: rgba(13, 17, 23, .32);\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  font-size: 22px;\r\n  font-weight: 700;\r\n  letter-spacing: .05em;\r\n  color: #fff;\r\n  text-shadow: 0 2px 6px rgba(0, 0, 0, .95);\r\n}\r\n.dpad-zone-hint {\r\n  position: absolute;\r\n  width: 48px;\r\n  height: 48px;\r\n  border-radius: 50%;\r\n  background: rgba(13, 17, 23, .72);\r\n  border: 2px solid rgba(255, 255, 255, .56);\r\n  box-shadow: 0 3px 12px rgba(0, 0, 0, .82);\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  font-size: 22px;\r\n  line-height: 1;\r\n  color: #fff;\r\n  text-shadow: 0 1px 4px rgba(0, 0, 0, .95);\r\n}\r\n.dpad-zone-up { top: 6%; left: 50%; transform: translateX(-50%); }\r\n.dpad-zone-down { bottom: 6%; left: 50%; transform: translateX(-50%); }\r\n.dpad-zone-left { left: 6%; top: 50%; transform: translateY(-50%); }\r\n.dpad-zone-right { right: 6%; top: 50%; transform: translateY(-50%); }\r\n@media (max-width: 520px) {\r\n  .dpad-zone-hint {\r\n    width: 38px;\r\n    height: 38px;\r\n    font-size: 18px;\r\n  }\r\n  .dpad-zone-center {\r\n    font-size: 18px;\r\n  }\r\n}\r\n.screen-controls {\r\n  display: flex;\r\n  margin-top: var(--s2);\r\n  justify-content: space-between;\r\n  align-items: center;\r\n  flex-wrap: wrap;\r\n  gap: var(--s2);\r\n}\r\n.screen-info-group, .screen-action-group {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 6px;\r\n  flex-wrap: wrap;\r\n}\r\n.mode-switch {\r\n  display: inline-flex;\r\n  background: var(--bg);\r\n  border: 1px solid var(--border);\r\n  border-radius: var(--r);\r\n  padding: 2px;\r\n  gap: 2px;\r\n}\r\n.mode-switch button {\r\n  height: 28px;\r\n  min-height: 28px;\r\n  padding: 0 10px;\r\n  font-size: var(--fs-xs);\r\n  border: none;\r\n  border-radius: calc(var(--r) - 2px);\r\n  background: transparent;\r\n  color: var(--muted);\r\n}\r\n.mode-switch button:hover {\r\n  color: var(--text);\r\n  background: rgba(255, 255, 255, .05);\r\n}\r\n.mode-switch button.active {\r\n  background: var(--action);\r\n  color: #0d1117;\r\n  font-weight: 600;\r\n}\r\n.btn-mini, a.link-pill {\r\n  display: inline-flex;\r\n  align-items: center;\r\n  justify-content: center;\r\n  height: 28px;\r\n  min-height: 28px;\r\n  padding: 0 9px;\r\n  font-size: var(--fs-xs);\r\n  font-weight: 500;\r\n  color: var(--text);\r\n  background: var(--btn);\r\n  border: 1px solid var(--border);\r\n  border-radius: var(--r);\r\n  text-decoration: none;\r\n  cursor: pointer;\r\n  white-space: nowrap;\r\n}\r\n.btn-mini:hover, a.link-pill:hover {\r\n  background: var(--btn-h);\r\n}\r\n.btn-mini.active {\r\n  border-color: var(--action);\r\n  background: rgba(88, 166, 255, .18);\r\n  color: #79c0ff;\r\n}\r\n.btn-mobile-text {\r\n  display: none;\r\n}\r\n@media (max-width: 520px) {\r\n  #btn-enter-theater .btn-label,\r\n  #link-standalone .btn-label {\r\n    display: none;\r\n  }\r\n  #btn-enter-theater,\r\n  #link-standalone {\r\n    padding: 0 7px;\r\n    font-size: var(--fs-s);\r\n  }\r\n  .box-title-row h2 {\r\n    font-size: var(--fs-m);\r\n  }\r\n  .box-header-actions {\r\n    max-width: 62%;\r\n    gap: 6px;\r\n  }\r\n  .status-badge {\r\n    max-width: 155px;\r\n    font-size: var(--fs-xs);\r\n    padding: 2px 8px;\r\n  }\r\n  .btn-desktop-text {\r\n    display: none;\r\n  }\r\n  .btn-mobile-text {\r\n    display: inline;\r\n  }\r\n  .input-btns button {\r\n    padding: var(--s2) 8px;\r\n  }\r\n  #keyboard-body .notice {\r\n    display: none;\r\n  }\r\n}\r\n.screen-hint {\r\n  margin: 6px 0 0;\r\n  font-size: var(--fs-xs);\r\n  color: var(--muted);\r\n}\r\n#standalone-banner {\r\n  display: none;\r\n  margin-bottom: var(--s2);\r\n  padding: var(--s2) var(--s3);\r\n  border-radius: var(--r);\r\n  background: rgba(88, 166, 255, .08);\r\n  border: 1px solid rgba(88, 166, 255, .35);\r\n}\r\n.standalone-row {\r\n  display: flex;\r\n  gap: 6px;\r\n  align-items: center;\r\n  flex-wrap: wrap;\r\n  margin-top: 6px;\r\n}\r\n.standalone-row input {\r\n  flex: 1;\r\n  min-width: 180px;\r\n  padding: 4px 8px;\r\n  font-size: var(--fs-xs);\r\n  font-family: ui-monospace, SFMono-Regular, Consolas, monospace;\r\n  background: var(--bg);\r\n  color: var(--action);\r\n  border: 1px solid var(--border);\r\n  border-radius: 6px;\r\n}\r\n.auto-refresh-label {\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 6px;\r\n  font-size: var(--fs-s);\r\n  cursor: pointer;\r\n  user-select: none;\r\n  color: var(--text);\r\n  white-space: nowrap;\r\n}\r\n.auto-refresh-label input {\r\n  cursor: pointer;\r\n  width: 15px;\r\n  height: 15px;\r\n  accent-color: var(--action);\r\n}\r\n.preset-switch button, .capture-switch button {\r\n  padding: 2px 8px;\r\n  font-size: 11px;\r\n  height: 22px;\r\n}\r\n.quality-ctrl {\r\n  display: inline-flex;\r\n  align-items: center;\r\n  gap: 4px;\r\n  font-size: 11px;\r\n  font-family: monospace;\r\n  color: var(--muted);\r\n  background: var(--bg);\r\n  border: 1px solid var(--border);\r\n  border-radius: 10px;\r\n  padding: 1px 7px;\r\n  height: 22px;\r\n  white-space: nowrap;\r\n}\r\n.quality-ctrl input[type=\"range\"] {\r\n  width: 64px;\r\n  height: 14px;\r\n  margin: 0;\r\n  cursor: pointer;\r\n  accent-color: var(--action);\r\n}\r\n#lbl-stream-quality {\r\n  min-width: 18px;\r\n  text-align: right;\r\n  color: var(--text);\r\n  font-weight: 600;\r\n}\r\n#only-theater-actions {\r\n  display: none;\r\n  align-items: center;\r\n  gap: 6px;\r\n}\r\n\r\n/* Fullscreen / Standalone Screen-Only Theater Mode */\r\nbody.is-screen-only {\r\n  margin: 0;\r\n  padding: 0;\r\n  width: 100vw;\r\n  height: 100vh;\r\n  height: 100dvh;\r\n  overflow: hidden;\r\n  background: #000;\r\n}\r\nbody.is-screen-only .container {\r\n  position: fixed;\r\n  top: 0;\r\n  left: 0;\r\n  width: 100vw;\r\n  height: 100vh;\r\n  height: 100dvh;\r\n  max-width: none;\r\n  margin: 0;\r\n  padding: 0;\r\n  display: flex;\r\n  flex-direction: column;\r\n  background: #000;\r\n  z-index: 999;\r\n}\r\nbody.is-screen-only.is-rotated-landscape .container {\r\n  width: 100vh;\r\n  width: 100dvh;\r\n  height: 100vw;\r\n  top: 50%;\r\n  left: 50%;\r\n  transform: translate(-50%, -50%) rotate(90deg);\r\n}\r\nbody.is-screen-only #box-screen > .box-header,\r\nbody.is-screen-only #screen-hint,\r\nbody.is-screen-only #standalone-banner,\r\nbody.is-screen-only .col-side,\r\nbody.is-screen-only #box-remote,\r\nbody.is-screen-only #box-playback,\r\nbody.is-screen-only #box-numpad,\r\nbody.is-screen-only #box-keyboard .box-header,\r\nbody.is-screen-only #cert-banner,\r\nbody.is-screen-only #keyboard-body .notice {\r\n  display: none !important;\r\n}\r\n/* By default in theater mode, hide .app-layout to save space on PC */\r\nbody.is-screen-only .app-layout {\r\n  display: none !important;\r\n  margin: 0;\r\n  padding: 0;\r\n  flex-shrink: 0;\r\n}\r\n/* When theater input is active (on mobile by default, or toggled on), show docked input */\r\nbody.is-screen-only.has-theater-input .app-layout {\r\n  display: block !important;\r\n}\r\nbody.is-screen-only.has-theater-input .col-main {\r\n  margin: 0;\r\n  padding: 0;\r\n}\r\nbody.is-screen-only.has-theater-input #box-keyboard {\r\n  margin: 0;\r\n  padding: 6px 10px;\r\n  background: var(--surface);\r\n  border: none;\r\n  border-top: 1px solid var(--border);\r\n  border-radius: 0;\r\n}\r\nbody.is-screen-only.has-theater-input #box-keyboard.is-collapsed #keyboard-body {\r\n  display: block !important;\r\n}\r\nbody.is-screen-only.has-theater-input #keyboard-body {\r\n  display: block !important;\r\n  margin: 0;\r\n  padding: 0;\r\n}\r\nbody.is-screen-only.has-theater-input #keyboard-body .input-row {\r\n  margin-bottom: 0;\r\n  gap: 6px;\r\n}\r\nbody.is-screen-only.has-theater-input #keyboard-body .input-row input {\r\n  height: 32px;\r\n  min-height: 32px;\r\n  font-size: var(--fs-xs);\r\n  padding: 0 10px;\r\n}\r\nbody.is-screen-only.has-theater-input #keyboard-body .input-row button {\r\n  height: 32px;\r\n  min-height: 32px;\r\n  font-size: var(--fs-xs);\r\n  padding: 0 10px;\r\n}\r\nbody.is-screen-only #box-screen {\r\n  flex: 1;\r\n  min-height: 0;\r\n  margin: 0;\r\n  padding: 0;\r\n  border: none;\r\n  border-radius: 0;\r\n  background: #000;\r\n  display: flex;\r\n  flex-direction: column;\r\n}\r\nbody.is-screen-only #screen-body {\r\n  flex: 1;\r\n  min-height: 0;\r\n  display: flex !important;\r\n  flex-direction: column;\r\n}\r\nbody.is-screen-only .screen-stage {\r\n  flex: 1;\r\n  min-height: 0;\r\n  padding: 2px;\r\n  background: #000;\r\n  overflow: hidden;\r\n}\r\nbody.is-screen-only .screen-frame {\r\n  border-radius: 4px;\r\n}\r\nbody.is-screen-only .screen-controls {\r\n  margin-top: 0;\r\n  padding: 6px 10px;\r\n  background: var(--surface);\r\n  border-top: 1px solid var(--border);\r\n  flex-wrap: nowrap;\r\n  overflow-x: auto;\r\n  gap: 8px;\r\n}\r\nbody.is-screen-only .screen-info-group,\r\nbody.is-screen-only .screen-action-group {\r\n  flex-wrap: nowrap;\r\n  flex-shrink: 0;\r\n}\r\nbody.is-screen-only #only-theater-actions {\r\n  display: inline-flex;\r\n}\r\n</style>\r\n</head>\r\n<body>\r\n\r\n<div class=\"container\">\r\n  <!-- Section: Screen Preview (Full width at top, collapsible) -->\r\n  <div id=\"box-screen\" class=\"box is-collapsed\">\r\n    <div class=\"box-header\">\r\n      <div class=\"box-title-row box-title-clickable\" id=\"screen-header\">\r\n        <h2>Screen preview</h2>\r\n        <div class=\"box-header-actions\">\r\n          <a id=\"link-standalone\" href=\"#screen\" rel=\"noopener\" class=\"link-pill\" title=\"Copy URL to open Screen Preview in a new tab (or right-click / long-press → Open in new tab)\"><span class=\"btn-icon\">↗</span><span class=\"btn-label\"> New Tab</span></a>\r\n          <button type=\"button\" id=\"btn-enter-theater\" class=\"btn-mini\" title=\"Expand Screen Preview to full viewport\"><span class=\"btn-icon\">⛶</span><span class=\"btn-label\"> Fullscreen</span></button>\r\n          <button type=\"button\" class=\"btn-collapse\" id=\"btn-toggle-screen\" title=\"Toggle Screen Preview\" aria-label=\"Toggle Screen Preview\" aria-expanded=\"false\">\r\n            <svg viewBox=\"0 0 24 24\"><polyline points=\"6 9 12 15 18 9\"></polyline></svg>\r\n          </button>\r\n        </div>\r\n      </div>\r\n      <p class=\"header-notice\">Interactive live TV display — tap, double-tap, hold, or drag directly on the preview to control the TV.</p>\r\n    </div>\r\n    <div id=\"screen-body\">\r\n      <div id=\"standalone-banner\">\r\n        <div style=\"display:flex;justify-content:space-between;align-items:center;gap:8px\">\r\n          <strong style=\"font-size:var(--fs-xs);color:#79c0ff\">↗ Open outside Vetro's small iframe</strong>\r\n          <button type=\"button\" id=\"btn-close-standalone\" class=\"btn-mini\" style=\"height:22px;min-height:22px;padding:0 6px\">✕</button>\r\n        </div>\r\n        <p style=\"margin:4px 0 0;font-size:var(--fs-xs);color:var(--text)\">\r\n          URL copied! Paste it into a new browser tab, or <strong>right-click / long-press \"↗ New Tab\"</strong> above and choose <em>Open in new tab</em>:\r\n        </p>\r\n        <div class=\"standalone-row\">\r\n          <input type=\"text\" id=\"standalone-url-input\" readonly>\r\n          <button type=\"button\" id=\"btn-copy-screen-url\" class=\"btn-mini active\">📋 Screen Fullscreen URL</button>\r\n          <button type=\"button\" id=\"btn-copy-plugin-url\" class=\"btn-mini\">📋 Full Plugin URL</button>\r\n        </div>\r\n      </div>\r\n      <div class=\"screen-stage\" id=\"screen-stage\">\r\n        <div class=\"screen-frame\" id=\"screen-frame\">\r\n          <img id=\"screen-img\" src=\"\" alt=\"TV Screen\" draggable=\"false\">\r\n          <canvas id=\"screen-canvas\" width=\"960\" height=\"540\" aria-label=\"TV Screen\"></canvas>\r\n          <div id=\"tv-cursor\" aria-hidden=\"true\"></div>\r\n          <div id=\"dpad-overlay\" aria-hidden=\"true\">\r\n            <span class=\"dpad-zone-hint dpad-zone-up\">▲</span>\r\n            <span class=\"dpad-zone-hint dpad-zone-down\">▼</span>\r\n            <span class=\"dpad-zone-hint dpad-zone-left\">◀</span>\r\n            <span class=\"dpad-zone-hint dpad-zone-right\">▶</span>\r\n            <div class=\"dpad-zone-center\">OK</div>\r\n          </div>\r\n          <div id=\"screen-spinner\" style=\"display:none;padding:var(--s5);text-align:center;color:var(--muted);font-size:var(--fs-s)\">Capturing screen from TV…</div>\r\n        </div>\r\n      </div>\r\n      <div class=\"screen-controls\">\r\n        <div class=\"screen-info-group\">\r\n          <div class=\"mode-switch\" role=\"group\" aria-label=\"Preview input mode\">\r\n            <button type=\"button\" id=\"btn-mode-pointer\" class=\"active\" title=\"Simulate TV mouse cursor (Browser &amp; pointer apps)\">🖱 Pointer</button>\r\n            <button type=\"button\" id=\"btn-mode-dpad\" title=\"Swipe or tap zones for D-Pad apps without cursor (e.g. YouTube)\">🕹 D-Pad</button>\r\n          </div>\r\n          <span id=\"pointer-tools\" style=\"display:inline-flex;align-items:center;gap:6px;flex-wrap:nowrap\">\r\n            <label class=\"auto-refresh-label\" title=\"Move TV cursor without clicking (useful to reveal hidden video controls)\">\r\n              <input type=\"checkbox\" id=\"chk-hover-only\">\r\n              <span>Move only</span>\r\n            </label>\r\n            <button type=\"button\" id=\"btn-right-mode\" class=\"btn-mini\" title=\"Make next tap send Right-Click\">Right-click</button>\r\n            <button type=\"button\" id=\"btn-scroll-up\" class=\"btn-mini\" title=\"Scroll TV wheel up\">▲</button>\r\n            <button type=\"button\" id=\"btn-scroll-down\" class=\"btn-mini\" title=\"Scroll TV wheel down\">▼</button>\r\n          </span>\r\n          <span id=\"dpad-tools\" style=\"display:none;align-items:center;gap:6px\">\r\n            <button type=\"button\" id=\"btn-preview-back\" class=\"btn-mini\" title=\"Send Back to TV\">↩ Back</button>\r\n          </span>\r\n          <label class=\"auto-refresh-label\" title=\"Continuous low-latency live TV display\">\r\n            <input type=\"checkbox\" id=\"chk-auto-refresh\">\r\n            <span>Live stream</span>\r\n          </label>\r\n          <span id=\"stream-quality-controls\" style=\"display:none;align-items:center;gap:6px;flex-wrap:wrap\">\r\n            <div class=\"mode-switch preset-switch\" role=\"group\" aria-label=\"Live stream resolution preset\">\r\n              <button type=\"button\" id=\"btn-preset-fast\" title=\"Fast (640×360, Q45, lowest bandwidth)\">Fast</button>\r\n              <button type=\"button\" id=\"btn-preset-balanced\" class=\"active\" title=\"Balanced (960×540, Q55, recommended)\">Balanced</button>\r\n              <button type=\"button\" id=\"btn-preset-hd\" title=\"HD (1280×720, Q72, sharp detail)\">HD</button>\r\n            </div>\r\n            <label class=\"quality-ctrl\" title=\"Fine-tune live stream JPEG quality (20-95)\">\r\n              <span>Q</span>\r\n              <input type=\"range\" id=\"rng-stream-quality\" min=\"20\" max=\"95\" step=\"5\" value=\"55\">\r\n              <span id=\"lbl-stream-quality\">55</span>\r\n            </label>\r\n          </span>\r\n          <div class=\"mode-switch capture-switch\" id=\"capture-mode-switch\" role=\"group\" aria-label=\"Capture backend\">\r\n            <button type=\"button\" id=\"btn-cap-auto\" class=\"active\" title=\"Hardware direct capture with automatic Wayland fallback (captures live TV &amp; video)\">Auto</button>\r\n            <button type=\"button\" id=\"btn-cap-wayland\" title=\"Force Wayland software capture (use if hardware capture shows wrong colors or aspect ratio)\">Wayland</button>\r\n          </div>\r\n          <span id=\"screen-time\" style=\"font-size:var(--fs-xs);color:var(--muted);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:260px;display:inline-block;vertical-align:middle\"></span>\r\n        </div>\r\n        <div class=\"screen-action-group\">\r\n          <span id=\"only-theater-actions\">\r\n            <button type=\"button\" id=\"btn-theater-input\" class=\"btn-mini\" title=\"Toggle on-screen input bar\">⌨ Input</button>\r\n            <button type=\"button\" id=\"btn-rotate-screen\" class=\"btn-mini\" title=\"Rotate 90° into landscape (useful on mobile with rotation locked)\">↻ Rotate</button>\r\n            <button type=\"button\" id=\"btn-native-fs\" class=\"btn-mini\" title=\"Toggle browser Fullscreen &amp; landscape orientation\">⛶ OS Fullscreen</button>\r\n            <button type=\"button\" id=\"btn-exit-theater\" class=\"btn-mini\" title=\"Show full Keyboard &amp; Remote plugin\">🎛 Full Plugin</button>\r\n          </span>\r\n          <button type=\"button\" id=\"btn-refresh-screen\" class=\"primary\" style=\"font-size:var(--fs-xs);height:28px;min-height:28px;padding:0 10px\">🔄 Capture / Refresh</button>\r\n        </div>\r\n      </div>\r\n      <p id=\"screen-hint\" class=\"screen-hint\">Tap: click · Double-tap: double-click · Hold or drag: press &amp; drag · Right-click or Shift+Wheel supported</p>\r\n    </div>\r\n  </div>\r\n\r\n  <div class=\"app-layout\">\r\n    <!-- Column 1: Controls (Keyboard, Remote, Numpad) -->\r\n    <div class=\"col-main\">\r\n      <!-- Section 1: Keyboard Input (Collapsible) -->\r\n      <div id=\"box-keyboard\" class=\"box\">\r\n        <div class=\"box-header\">\r\n          <div class=\"box-title-row box-title-clickable\" id=\"keyboard-header\">\r\n            <h2>Keyboard input</h2>\r\n            <div class=\"box-header-actions\">\r\n              <div id=\"status\" class=\"status-badge busy\">Connecting…</div>\r\n              <button type=\"button\" class=\"btn-collapse\" id=\"btn-toggle-keyboard\" title=\"Toggle Keyboard input\" aria-label=\"Toggle Keyboard input\" aria-expanded=\"true\">\r\n                <svg viewBox=\"0 0 24 24\"><polyline points=\"6 9 12 15 18 9\"></polyline></svg>\r\n              </button>\r\n            </div>\r\n          </div>\r\n          <p class=\"header-notice\">Type text into the focused field on the TV (YouTube, browser, apps). Supports any language.</p>\r\n        </div>\r\n\r\n        <div id=\"keyboard-body\">\r\n          <div id=\"cert-banner\">\r\n            <div style=\"font-weight:600;margin-bottom:var(--s1)\">⚠️ TV Permission for port 8002</div>\r\n            <p style=\"font-size:var(--fs-s);color:var(--text);margin-bottom:var(--s2)\">\r\n              To enable direct Unicode typing, open this URL in a new browser tab and tap <strong>Advanced → Proceed</strong>:\r\n            </p>\r\n            <div class=\"cert-url-bar\">\r\n              <input type=\"text\" id=\"cert-url\" readonly>\r\n            </div>\r\n            <div class=\"cert-btn-bar\">\r\n              <button type=\"button\" id=\"btn-copy-cert\" class=\"primary\">📋 Copy URL</button>\r\n              <button type=\"button\" id=\"btn-reconnect\">🔄 Reconnect</button>\r\n              <button type=\"button\" id=\"btn-repair\">Reset Pairing</button>\r\n            </div>\r\n            <p style=\"font-size:.78rem;color:var(--muted);margin-top:var(--s2);margin-bottom:0\">\r\n              <em>Tip:</em> Tap <strong>Copy URL</strong> and paste it into a new browser tab, accept the certificate (<strong>Advanced → Proceed</strong>), then return here and tap <strong>Reconnect</strong>.\r\n            </p>\r\n          </div>\r\n\r\n          <div class=\"input-row\">\r\n            <input type=\"text\" id=\"ti\" placeholder=\"Type text here…\" autocomplete=\"off\" spellcheck=\"false\" dir=\"auto\">\r\n            <div class=\"input-btns\">\r\n              <button type=\"button\" class=\"primary\" id=\"btn-send\">Send ↵</button>\r\n              <button type=\"button\" class=\"danger\" id=\"btn-bksp\">⌫ Del</button>\r\n              <button type=\"button\" class=\"btn\" id=\"btn-select-all\" title=\"Select all text in focused TV input (Ctrl+A)\"><span class=\"btn-desktop-text\">Select All</span><span class=\"btn-mobile-text\">Sel All</span></button>\r\n            </div>\r\n          </div>\r\n          <p class=\"notice\" style=\"margin-bottom:0\">\r\n            <span class=\"kbd\">Enter</span> — send / submit &nbsp;·&nbsp;\r\n            <span class=\"kbd\">Ctrl+Enter</span> — OK &nbsp;·&nbsp;\r\n            <span class=\"kbd\">Ctrl+S</span> — Search &nbsp;·&nbsp;\r\n            <span class=\"kbd\">Esc</span> — Back\r\n          </p>\r\n        </div>\r\n      </div>\r\n\r\n      <!-- Section 2: Remote Control & Navigation -->\r\n      <div id=\"box-remote\" class=\"box\">\r\n        <div class=\"box-header\">\r\n          <div class=\"box-title-row\">\r\n            <h2>Remote control</h2>\r\n          </div>\r\n          <p class=\"header-notice\">Ergonomic directional pad and quick controls. Hold buttons for continuous scrolling.</p>\r\n        </div>\r\n\r\n        <!-- D-Pad Directional Cluster -->\r\n        <div class=\"dpad-cluster\">\r\n          <button type=\"button\" data-key=\"XF86Home\" title=\"Home\">⌂ Home</button>\r\n          <button type=\"button\" data-key=\"Up\" aria-label=\"Up\">▲</button>\r\n          <button type=\"button\" data-key=\"XF86Back\" title=\"Back\">↩ Back</button>\r\n          <button type=\"button\" data-key=\"Left\" aria-label=\"Left\">◀</button>\r\n          <button type=\"button\" class=\"primary dpad-ok\" data-key=\"Return\">OK</button>\r\n          <button type=\"button\" data-key=\"Right\" aria-label=\"Right\">▶</button>\r\n          <button type=\"button\" data-key=\"XF86Menu\" title=\"Menu\">☰ Menu</button>\r\n          <button type=\"button\" data-key=\"Down\" aria-label=\"Down\">▼</button>\r\n          <button type=\"button\" data-key=\"XF86Exit\" title=\"Exit\">✕ Exit</button>\r\n        </div>\r\n\r\n        <!-- Volume & Channel Rockers -->\r\n        <div class=\"rocker-section\">\r\n          <div class=\"rocker-pill\">\r\n            <span class=\"rocker-tag\">VOL</span>\r\n            <button type=\"button\" data-key=\"XF86AudioRaiseVolume\" title=\"Volume Up\">＋</button>\r\n            <button type=\"button\" data-key=\"XF86AudioMute\" title=\"Mute\">🔇</button>\r\n            <button type=\"button\" data-key=\"XF86AudioLowerVolume\" title=\"Volume Down\">－</button>\r\n          </div>\r\n          <div class=\"center-stack\">\r\n            <button type=\"button\" data-key=\"XF86Info\">ℹ Info</button>\r\n            <button type=\"button\" data-key=\"XF86ChannelGuide\">📅 Guide</button>\r\n            <button type=\"button\" data-key=\"XF86ChannelList\">📋 Channels</button>\r\n          </div>\r\n          <div class=\"rocker-pill\">\r\n            <span class=\"rocker-tag\">CH</span>\r\n            <button type=\"button\" data-key=\"XF86RaiseChannel\" title=\"Channel Up\">▲</button>\r\n            <button type=\"button\" data-key=\"XF86PreviousChannel\" title=\"Previous Channel\">⤾</button>\r\n            <button type=\"button\" data-key=\"XF86LowerChannel\" title=\"Channel Down\">▼</button>\r\n          </div>\r\n        </div>\r\n\r\n        <p class=\"sec\">System &amp; Display</p>\r\n        <div class=\"grid-4\">\r\n          <button type=\"button\" class=\"danger\" data-key=\"XF86PowerOff\">⏻ Power</button>\r\n          <button type=\"button\" data-key=\"XF86TV\">📺 Source</button>\r\n          <button type=\"button\" data-key=\"XF86QuickMenu\">⚙ Quick</button>\r\n          <button type=\"button\" data-key=\"XF86Search\">🔍 Search</button>\r\n          <button type=\"button\" data-key=\"XF86Subtitle\">💬 Subtitle</button>\r\n          <button type=\"button\" data-key=\"XF86MultiView\">📱 MultiView</button>\r\n          <button type=\"button\" data-key=\"XF86PictureSize\">📐 Aspect</button>\r\n          <button type=\"button\" data-key=\"XF86Ambient\">🖼 Ambient</button>\r\n        </div>\r\n      </div>\r\n    </div>\r\n\r\n    <!-- Column 2: Display & Playback (Playback & Colors, Number Pad) -->\r\n    <div class=\"col-side\">\r\n      <!-- Section 3: Playback & Colors (Collapsible) -->\r\n      <div id=\"box-playback\" class=\"box\">\r\n        <div class=\"box-header\">\r\n          <div class=\"box-title-row box-title-clickable\" id=\"playback-header\">\r\n            <h2>Playback &amp; Colors</h2>\r\n            <div class=\"box-header-actions\">\r\n              <button type=\"button\" class=\"btn-collapse\" id=\"btn-toggle-playback\" title=\"Toggle Playback & Colors\" aria-label=\"Toggle Playback & Colors\" aria-expanded=\"true\">\r\n                <svg viewBox=\"0 0 24 24\"><polyline points=\"6 9 12 15 18 9\"></polyline></svg>\r\n              </button>\r\n            </div>\r\n          </div>\r\n        </div>\r\n\r\n        <div id=\"playback-body\">\r\n          <div class=\"media-grid\" style=\"margin-bottom:var(--s3)\">\r\n            <button type=\"button\" data-key=\"XF86AudioRewind\">⏪ Rew</button>\r\n            <button type=\"button\" data-key=\"XF86AudioPlayPause\">⏯ P/P</button>\r\n            <button type=\"button\" data-key=\"XF86AudioForward\">⏩ FF</button>\r\n            <button type=\"button\" data-key=\"XF86PreviousChapter\">⏮ Prev</button>\r\n            <button type=\"button\" data-key=\"XF86AudioStop\">⏹ Stop</button>\r\n            <button type=\"button\" data-key=\"XF86NextChapter\">⏭ Next</button>\r\n            <button type=\"button\" data-key=\"XF86AudioPause\">⏸ Pause</button>\r\n            <button type=\"button\" data-key=\"XF86AudioPlay\" class=\"primary\">▶ Play</button>\r\n            <button type=\"button\" data-key=\"XF86AudioRecord\">⏺ Rec</button>\r\n          </div>\r\n\r\n          <p class=\"sec\" style=\"margin-top:0\">Color Keys</p>\r\n          <div class=\"color-grid\">\r\n            <button type=\"button\" class=\"btn-red\" data-key=\"XF86Red\">🔴 Red</button>\r\n            <button type=\"button\" class=\"btn-green\" data-key=\"XF86Green\">🟢 Green</button>\r\n            <button type=\"button\" class=\"btn-yellow\" data-key=\"XF86Yellow\">🟡 Yellow</button>\r\n            <button type=\"button\" data-key=\"XF86Blue\">🔵 Blue</button>\r\n          </div>\r\n        </div>\r\n      </div>\r\n\r\n      <!-- Section 4: Number Pad -->\r\n      <div id=\"box-numpad\" class=\"box\">\r\n        <div class=\"box-header\">\r\n          <div class=\"box-title-row\">\r\n            <h2>Number pad</h2>\r\n          </div>\r\n        </div>\r\n        <div class=\"numpad\">\r\n          <button type=\"button\" data-key=\"1\">1</button>\r\n          <button type=\"button\" data-key=\"2\">2</button>\r\n          <button type=\"button\" data-key=\"3\">3</button>\r\n          <button type=\"button\" data-key=\"4\">4</button>\r\n          <button type=\"button\" data-key=\"5\">5</button>\r\n          <button type=\"button\" data-key=\"6\">6</button>\r\n          <button type=\"button\" data-key=\"7\">7</button>\r\n          <button type=\"button\" data-key=\"8\">8</button>\r\n          <button type=\"button\" data-key=\"9\">9</button>\r\n          <button type=\"button\" data-key=\"minus\">−</button>\r\n          <button type=\"button\" data-key=\"0\">0</button>\r\n          <button type=\"button\" data-key=\"BackSpace\">⌫</button>\r\n        </div>\r\n      </div>\r\n    </div>\r\n  </div>\r\n</div>\r\n\r\n<script>\r\nvar isStandaloneTab = false;\r\ntry { isStandaloneTab = (window.self === window.top); } catch (eTop) { isStandaloneTab = false; }\r\nvar hostFromUrl = location.hostname || \"\";\r\nvar isFallbackHost = !hostFromUrl || hostFromUrl === \"127.0.0.1\" || hostFromUrl === \"localhost\" || hostFromUrl === \"::1\" || hostFromUrl === \"[::1]\";\r\nvar tvIp = hostFromUrl || \"127.0.0.1\";\r\nvar tvToken = null;\r\nvar tvDeviceTag = null;\r\nvar tvTokenIsLegacy = false;\r\nvar ws = null;\r\nvar wsConnected = false;\r\nvar wsConnecting = false;\r\nvar wsMouseReady = false;\r\nvar activePort = 8002;\r\nvar activeHoldKey = null;\r\nvar authAttempts = 0;\r\nvar MAX_AUTH_ATTEMPTS = 2;\r\nvar authRetryTimer = null;\r\nvar wsOpenedOnce = false;\r\nvar statusCanRetry = false;\r\nvar lastRetryStatus = null;\r\nvar statusRestoreTimer = null;\r\n\r\nvar isTouch = (\"ontouchstart\" in window) || (navigator.maxTouchPoints > 0);\r\nvar isMobile = /Android|iPhone|iPad|iPod|webOS|BlackBerry|IEMobile|Opera Mini/i.test(navigator.userAgent) ||\r\n  (window.matchMedia && window.matchMedia(\"(pointer: coarse) and (hover: none)\").matches);\r\n\r\nvar statusEl = document.getElementById(\"status\");\r\nvar ti = document.getElementById(\"ti\");\r\nvar certBanner = document.getElementById(\"cert-banner\");\r\nvar certUrlInput = document.getElementById(\"cert-url\");\r\nvar btnCopyCert = document.getElementById(\"btn-copy-cert\");\r\nvar btnReconnect = document.getElementById(\"btn-reconnect\");\r\nvar btnRepair = document.getElementById(\"btn-repair\");\r\n\r\n// Prevent mobile virtual keyboard from reappearing when tapping remote buttons or background\r\ndocument.addEventListener(\"pointerdown\", function (e) {\r\n  if (e.target && e.target !== ti && !e.target.closest(\"#box-keyboard\")) {\r\n    if (document.activeElement === ti) {\r\n      ti.blur();\r\n    }\r\n  }\r\n}, true);\r\n\r\nvar fullCertUrl = \"https://\" + tvIp + \":8002/api/v2/\";\r\n\r\nfunction updateCertUrl() {\r\n  fullCertUrl = \"https://\" + tvIp + \":8002/api/v2/\";\r\n  if (certUrlInput) certUrlInput.value = fullCertUrl;\r\n}\r\nupdateCertUrl();\r\n\r\nif (btnCopyCert) {\r\n  btnCopyCert.onclick = function () {\r\n    if (navigator.clipboard && navigator.clipboard.writeText) {\r\n      navigator.clipboard.writeText(fullCertUrl).then(function () {\r\n        btnCopyCert.textContent = \"✔ Copied!\";\r\n        setTimeout(function () { btnCopyCert.textContent = \"📋 Copy URL\"; }, 2500);\r\n      }).catch(function () {\r\n        certUrlInput.select();\r\n        document.execCommand(\"copy\");\r\n        btnCopyCert.textContent = \"✔ Copied!\";\r\n        setTimeout(function () { btnCopyCert.textContent = \"📋 Copy URL\"; }, 2500);\r\n      });\r\n    } else {\r\n      certUrlInput.select();\r\n      document.execCommand(\"copy\");\r\n      btnCopyCert.textContent = \"✔ Copied!\";\r\n      setTimeout(function () { btnCopyCert.textContent = \"📋 Copy URL\"; }, 2500);\r\n    }\r\n  };\r\n}\r\n\r\nif (btnReconnect) {\r\n  btnReconnect.onclick = function () {\r\n    retryPairing();\r\n  };\r\n}\r\n\r\nif (btnRepair) {\r\n  btnRepair.onclick = function () {\r\n    if (authRetryTimer) {\r\n      clearTimeout(authRetryTimer);\r\n      authRetryTimer = null;\r\n    }\r\n    authAttempts = 0;\r\n    tvToken = null;\r\n    tvTokenIsLegacy = false;\r\n    lastRetryStatus = null;\r\n    setStatus(\"Resetting pairing…\", \"busy\");\r\n    fetch(\"savetoken\", {\r\n      method: \"POST\",\r\n      headers: { \"Content-Type\": \"text/plain\" },\r\n      body: JSON.stringify({ reset: true })\r\n    }).then(function () {\r\n      retryPairing();\r\n    }).catch(function () {\r\n      retryPairing();\r\n    });\r\n  };\r\n}\r\n\r\nfunction setStatus(msg, cls, canRetry) {\r\n  if (statusRestoreTimer) {\r\n    clearTimeout(statusRestoreTimer);\r\n    statusRestoreTimer = null;\r\n  }\r\n  statusCanRetry = !!canRetry;\r\n  statusEl.textContent = msg;\r\n  statusEl.className = \"status-badge\" + (cls ? \" \" + cls : \"\") + (statusCanRetry ? \" is-retryable\" : \"\");\r\n  if (statusCanRetry) {\r\n    lastRetryStatus = { msg: msg, cls: cls };\r\n    statusEl.setAttribute(\"role\", \"button\");\r\n    statusEl.setAttribute(\"tabindex\", \"0\");\r\n    statusEl.title = msg + \" — Tap to retry pairing\";\r\n  } else {\r\n    statusEl.removeAttribute(\"role\");\r\n    statusEl.removeAttribute(\"tabindex\");\r\n    statusEl.title = msg;\r\n    if (cls === \"ok\" && wsConnected) {\r\n      lastRetryStatus = null;\r\n    } else if (!wsConnected && !wsConnecting && lastRetryStatus) {\r\n      statusRestoreTimer = setTimeout(function () {\r\n        statusRestoreTimer = null;\r\n        if (!wsConnected && !wsConnecting && lastRetryStatus) {\r\n          setStatus(lastRetryStatus.msg, lastRetryStatus.cls, true);\r\n        }\r\n      }, 2500);\r\n    }\r\n  }\r\n}\r\n\r\nfunction retryPairing() {\r\n  if (authRetryTimer) {\r\n    clearTimeout(authRetryTimer);\r\n    authRetryTimer = null;\r\n  }\r\n  if (statusRestoreTimer) {\r\n    clearTimeout(statusRestoreTimer);\r\n    statusRestoreTimer = null;\r\n  }\r\n  authAttempts = 0;\r\n  var prevWs = ws;\r\n  ws = null;\r\n  if (prevWs) {\r\n    try { prevWs.close(); } catch (e) {}\r\n  }\r\n  wsConnected = false;\r\n  wsConnecting = false;\r\n  wsMouseReady = false;\r\n  initWS();\r\n}\r\n\r\nif (statusEl) {\r\n  statusEl.addEventListener(\"click\", function (e) {\r\n    if (!statusCanRetry) return;\r\n    e.stopPropagation();\r\n    retryPairing();\r\n    try { statusEl.blur(); } catch (err) {}\r\n  });\r\n  statusEl.addEventListener(\"keydown\", function (e) {\r\n    if (!statusCanRetry) return;\r\n    if (e.key === \"Enter\" || e.key === \" \" || e.keyCode === 13 || e.keyCode === 32) {\r\n      e.preventDefault();\r\n      e.stopPropagation();\r\n      retryPairing();\r\n      try { statusEl.blur(); } catch (err) {}\r\n    }\r\n  });\r\n}\r\n\r\nfunction utf8b64(str) {\r\n  return btoa(unescape(encodeURIComponent(str)));\r\n}\r\n\r\nfunction getClientAppName() {\r\n  var ua = (typeof navigator !== \"undefined\" && navigator.userAgent) || \"\";\r\n  var dev = \"Device\";\r\n  if (/Android/i.test(ua)) dev = \"Android\";\r\n  else if (/iPhone/i.test(ua)) dev = \"iPhone\";\r\n  else if (/iPad/i.test(ua)) dev = \"iPad\";\r\n  else if (/Windows/i.test(ua)) dev = \"Windows\";\r\n  else if (/Macintosh|Mac OS/i.test(ua)) dev = \"Mac\";\r\n  else if (/CrOS/i.test(ua)) dev = \"ChromeOS\";\r\n  else if (/Linux/i.test(ua)) dev = \"Linux\";\r\n\r\n  if (tvDeviceTag && /^[0-9a-f]{4}$/i.test(tvDeviceTag)) {\r\n    return (\"Vetro (\" + dev + \" #\" + tvDeviceTag.toLowerCase() + \")\").slice(0, 30);\r\n  }\r\n\r\n  var browser = \"\";\r\n  if (/Edg\\//i.test(ua)) browser = \"Edge\";\r\n  else if (/OPR\\//i.test(ua) || /Opera/i.test(ua)) browser = \"Opera\";\r\n  else if (/Chrome\\//i.test(ua)) browser = \"Chrome\";\r\n  else if (/Firefox\\//i.test(ua)) browser = \"Firefox\";\r\n  else if (/Safari\\//i.test(ua) && !/Chrome\\//i.test(ua)) browser = \"Safari\";\r\n\r\n  var label = \"Vetro (\" + dev + (browser ? \" \" + browser : \"\") + \")\";\r\n  return label.slice(0, 30);\r\n}\r\n\r\n// Repeatable keys that benefit from continuous hold\r\nvar REPEAT_KEYS = {\r\n  \"Up\": true, \"Down\": true, \"Left\": true, \"Right\": true,\r\n  \"XF86AudioRaiseVolume\": true, \"XF86AudioLowerVolume\": true,\r\n  \"XF86RaiseChannel\": true, \"XF86LowerChannel\": true,\r\n  \"BackSpace\": true\r\n};\r\n\r\n// Samsung Remote WebSocket API key names (universal across 2016-2024+ Samsung TVs)\r\nvar WS_KEY_MAP = {\r\n  // Navigation & Core\r\n  \"Up\": \"KEY_UP\", \"Down\": \"KEY_DOWN\", \"Left\": \"KEY_LEFT\", \"Right\": \"KEY_RIGHT\",\r\n  \"Return\": \"KEY_ENTER\", \"XF86Home\": \"KEY_HOME\", \"XF86Back\": \"KEY_RETURN\",\r\n  \"Escape\": \"KEY_RETURN\",\r\n  \"XF86Exit\": \"KEY_EXIT\", \"XF86Menu\": \"KEY_MENU\", \"XF86Info\": \"KEY_INFO\",\r\n  // Volume