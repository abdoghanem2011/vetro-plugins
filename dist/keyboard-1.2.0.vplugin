xt);\r\nvar STREAM_PRESET_DEFAULTS = {\r\n  fast: { width: 640, height: 360, quality: 45 },\r\n  balanced: { width: 960, height: 540, quality: 55 },\r\n  hd: { width: 1280, height: 720, quality: 72 }\r\n};\r\n\r\nfunction updateCaptureUI(cap) {\r\n  if (!cap || typeof cap !== \"object\") return;\r\n  if (cap.mode === \"auto\" || cap.mode === \"wayland\") {\r\n    captureMode = cap.mode;\r\n  }\r\n  captureBackendInfo = cap;\r\n  if (btnCapAuto) btnCapAuto.classList.toggle(\"active\", captureMode === \"auto\");\r\n  if (btnCapWayland) btnCapWayland.classList.toggle(\"active\", captureMode === \"wayland\");\r\n  if (screenTime) {\r\n    var parts = [];\r\n    if (cap.activeBackend) parts.push(\"backend=\" + cap.activeBackend);\r\n    if (cap.hwArch) parts.push(\"arch=\" + cap.hwArch);\r\n    if (cap.hwAbi) parts.push(\"abi=\" + cap.hwAbi);\r\n    if (cap.hwReason) parts.push(\"info=\" + cap.hwReason);\r\n    screenTime.title = parts.join(\" · \");\r\n  }\r\n}\r\n\r\nfunction refreshCaptureStatus() {\r\n  fetch(\"status\", { cache: \"no-store\" })\r\n    .then(function (r) { return r.json(); })\r\n    .then(function (d) {\r\n      if (d && d.capture) {\r\n        updateCaptureUI(d.capture);\r\n        if (chkAutoRefresh && chkAutoRefresh.checked && !streamFallbackPolling && currentLiveFps >= 0) {\r\n          formatLiveStreamLabel(currentStreamWidth, currentStreamHeight);\r\n        }\r\n      }\r\n    })\r\n    .catch(function () {});\r\n}\r\n\r\nfunction getBackendBadgeText() {\r\n  var ab = captureBackendInfo && captureBackendInfo.activeBackend;\r\n  if (ab === \"hw\") return \"⚡ HW\";\r\n  if (ab === \"wayland\") return \"Wayland\";\r\n  return (captureMode === \"wayland\") ? \"Wayland\" : \"🔴 Live\";\r\n}\r\n\r\nfunction formatLiveStreamLabel(w, h) {\r\n  var badge = getBackendBadgeText();\r\n  var fpsPart = currentLiveFps > 0 ? (\" · \" + currentLiveFps + \" fps\") : \"\";\r\n  var dimPart = (w && h) ? (\" · \" + w + \"×\" + h) : \"\";\r\n  if (screenTime) {\r\n    screenTime.textContent = badge + fpsPart + dimPart + \" · Q\" + currentStreamQuality;\r\n  }\r\n}\r\n\r\nfunction postCaptureMode(mode) {\r\n  if (mode !== \"auto\" && mode !== \"wayland\") return;\r\n  captureMode = mode;\r\n  if (btnCapAuto) btnCapAuto.classList.toggle(\"active\", captureMode === \"auto\");\r\n  if (btnCapWayland) btnCapWayland.classList.toggle(\"active\", captureMode === \"wayland\");\r\n  if (chkAutoRefresh && chkAutoRefresh.checked && screenTime) {\r\n    screenTime.textContent = \"Switching capture to \" + (mode === \"auto\" ? \"Auto (HW)\" : \"Wayland\") + \"…\";\r\n  }\r\n  fetch(\"capture_mode\", {\r\n    method: \"POST\",\r\n    headers: { \"Content-Type\": \"text/plain\" },\r\n    body: JSON.stringify({ mode: mode })\r\n  }).then(function (r) { return r.json(); })\r\n    .then(function (d) {\r\n      if (d && d.ok && d.capture) {\r\n        updateCaptureUI(d.capture);\r\n      }\r\n      setTimeout(refreshCaptureStatus, 450);\r\n    })\r\n    .catch(function () {});\r\n}\r\n\r\nif (btnCapAuto) {\r\n  btnCapAuto.addEventListener(\"click\", function () {\r\n    postCaptureMode(\"auto\");\r\n    btnCapAuto.blur();\r\n  });\r\n}\r\nif (btnCapWayland) {\r\n  btnCapWayland.addEventListener(\"click\", function () {\r\n    postCaptureMode(\"wayland\");\r\n    btnCapWayland.blur();\r\n  });\r\n}\r\n\r\nfunction updateStreamQualityVisibility() {\r\n  if (!streamQualityControls) return;\r\n  streamQualityControls.style.display = (chkAutoRefresh && chkAutoRefresh.checked) ? \"inline-flex\" : \"none\";\r\n  if (isScreenOnly) fitScreenFrame();\r\n}\r\n\r\nfunction updatePresetButtons(mode) {\r\n  currentStreamPreset = mode;\r\n  if (btnPresetFast) btnPresetFast.classList.toggle(\"active\", mode === \"fast\");\r\n  if (btnPresetBalanced) btnPresetBalanced.classList.toggle(\"active\", mode === \"balanced\");\r\n  if (btnPresetHd) btnPresetHd.classList.toggle(\"active\", mode === \"hd\");\r\n}\r\n\r\nfunction updateStreamConfigUI(cfg) {\r\n  if (!cfg || typeof cfg !== \"object\") return;\r\n  if (cfg.preset || cfg.mode) {\r\n    var m = cfg.preset || cfg.mode;\r\n    if (STREAM_PRESET_DEFAULTS[m]) {\r\n      updatePresetButtons(m);\r\n      currentStreamWidth = cfg.width || STREAM_PRESET_DEFAULTS[m].width;\r\n      currentStreamHeight = cfg.height || STREAM_PRESET_DEFAULTS[m].height;\r\n    }\r\n  }\r\n  if (typeof cfg.width === \"number\" && isFinite(cfg.width)) currentStreamWidth = cfg.width;\r\n  if (typeof cfg.height === \"number\" && isFinite(cfg.height)) currentStreamHeight = cfg.height;\r\n  if (cfg.quality !== undefined && cfg.quality !== null && isFinite(Number(cfg.quality))) {\r\n    currentStreamQuality = Math.max(20, Math.min(95, Math.round(Number(cfg.quality))));\r\n    if (rngStreamQuality) rngStreamQuality.value = String(currentStreamQuality);\r\n    if (lblStreamQuality) lblStreamQuality.textContent = String(currentStreamQuality);\r\n  }\r\n}\r\n\r\nfunction postStreamConfig(payload) {\r\n  fetch(\"stream_preset\", {\r\n    method: \"POST\",\r\n    headers: { \"Content-Type\": \"text/plain\" },\r\n    body: JSON.stringify(payload)\r\n  }).then(function (r) { return r.json(); })\r\n    .then(function (d) {\r\n      if (d && d.ok) {\r\n        updateStreamConfigUI(d);\r\n        if (chkAutoRefresh && chkAutoRefresh.checked && !streamFallbackPolling) {\r\n          formatLiveStreamLabel(currentStreamWidth, currentStreamHeight);\r\n        }\r\n      }\r\n    })\r\n    .catch(function () {});\r\n}\r\n\r\nfunction setStreamPreset(mode) {\r\n  var p = STREAM_PRESET_DEFAULTS[mode];\r\n  if (!p) return;\r\n  updateStreamConfigUI({ preset: mode, width: p.width, height: p.height, quality: p.quality });\r\n  if (chkAutoRefresh && chkAutoRefresh.checked && !streamFallbackPolling) {\r\n    screenTime.textContent = \"Switching to \" + p.width + \"×\" + p.height + \"…\";\r\n  }\r\n  postStreamConfig({ preset: mode });\r\n}\r\n\r\nfunction setStreamQuality(q) {\r\n  var val = Math.max(20, Math.min(95, Math.round(Number(q) || 55)));\r\n  currentStreamQuality = val;\r\n  if (lblStreamQuality) lblStreamQuality.textContent = String(val);\r\n  postStreamConfig({ quality: val });\r\n}\r\n\r\nif (btnPresetFast) {\r\n  btnPresetFast.addEventListener(\"click\", function () {\r\n    setStreamPreset(\"fast\");\r\n    btnPresetFast.blur();\r\n  });\r\n}\r\nif (btnPresetBalanced) {\r\n  btnPresetBalanced.addEventListener(\"click\", function () {\r\n    setStreamPreset(\"balanced\");\r\n    btnPresetBalanced.blur();\r\n  });\r\n}\r\nif (btnPresetHd) {\r\n  btnPresetHd.addEventListener(\"click\", function () {\r\n    setStreamPreset(\"hd\");\r\n    btnPresetHd.blur();\r\n  });\r\n}\r\nif (rngStreamQuality) {\r\n  rngStreamQuality.addEventListener(\"input\", function () {\r\n    if (lblStreamQuality) lblStreamQuality.textContent = rngStreamQuality.value;\r\n  });\r\n  rngStreamQuality.addEventListener(\"change\", function () {\r\n    setStreamQuality(rngStreamQuality.value);\r\n    rngStreamQuality.blur();\r\n  });\r\n}\r\n\r\nfunction abortBinStream() {\r\n  if (binStreamAbort) {\r\n    var ac = binStreamAbort;\r\n    binStreamAbort = null;\r\n    try { ac.abort(); } catch (e) {}\r\n  }\r\n  canvasPendingFrame = null;\r\n}\r\n\r\nfunction concatUint8(a, b) {\r\n  if (!a || a.length === 0) return b;\r\n  if (!b || b.length === 0) return a;\r\n  var out = new Uint8Array(a.length + b.length);\r\n  out.set(a, 0);\r\n  out.set(b, a.length);\r\n  return out;\r\n}\r\n\r\nfunction pumpCanvasDecode() {\r\n  if (canvasDecodeBusy || !canvasPendingFrame) return;\r\n  var item = canvasPendingFrame;\r\n  canvasPendingFrame = null;\r\n  canvasDecodeBusy = true;\r\n  var ctx2d = screenCanvas ? screenCanvas.getContext(\"2d\") : null;\r\n  if (!ctx2d) {\r\n    canvasDecodeBusy = false;\r\n    return;\r\n  }\r\n  window.createImageBitmap(item.blob).then(function (bmp) {\r\n    try {\r\n      ctx2d.drawImage(bmp, 0, 0, screenCanvas.width, screenCanvas.height);\r\n      streamFailCount = 0;\r\n      var now = Date.now();\r\n      if (!fpsWindowStart) fpsWindowStart = now;\r\n      fpsWindowCount++;\r\n      if (now - fpsWindowStart >= 1000) {\r\n        currentLiveFps = Math.max(1, Math.round(fpsWindowCount * 1000 / (now - fpsWindowStart)));\r\n        fpsWindowCount = 0;\r\n        fpsWindowStart = now;\r\n      }\r\n      formatLiveStreamLabel(item.w || bmp.width, item.h || bmp.height);\r\n    } finally {\r\n      if (bmp && typeof bmp.close === \"function\") bmp.close();\r\n      canvasDecodeBusy = false;\r\n      if (canvasPendingFrame) pumpCanvasDecode();\r\n    }\r\n  }, function () {\r\n    canvasDecodeBusy = false;\r\n    if (canvasPendingFrame) pumpCanvasDecode();\r\n  });\r\n}\r\n\r\nfunction startBinCanvasStream() {\r\n  abortBinStream();\r\n  fpsWindowCount = 0;\r\n  fpsWindowStart = Date.now();\r\n  currentLiveFps = 0;\r\n\r\n  var ctrl = new window.AbortController();\r\n  binStreamAbort = ctrl;\r\n\r\n  if (screenImg) {\r\n    screenImg.onerror = null;\r\n    screenImg.onload = null;\r\n    screenImg.src = \"\";\r\n    screenImg.style.display = \"none\";\r\n  }\r\n  if (screenCanvas) screenCanvas.style.display = \"block\";\r\n  if (screenSpinner) screenSpinner.style.display = \"none\";\r\n  if (screenFrame) screenFrame.classList.add(\"has-image\");\r\n  hasScreenImage = true;\r\n\r\n  var statusTimer = setTimeout(refreshCaptureStatus, 450);\r\n\r\n  function handleBinFailure() {\r\n    clearTimeout(statusTimer);\r\n    if (binStreamAbort !== ctrl) return;\r\n    binStreamAbort = null;\r\n    if (!chkAutoRefresh || !chkAutoRefresh.checked) return;\r\n    if (document.hidden) return;\r\n    if (boxScreen.classList.contains(\"is-collapsed\") && !isScreenOnly) return;\r\n    streamFailCount++;\r\n    if (streamFailCount === 1) {\r\n      screenTime.textContent = \"Reconnecting live stream…\";\r\n      autoRefreshTimer = setTimeout(startLiveStream, 1500);\r\n    } else if (!forceImgStreamFallback && streamFailCount === 2) {\r\n      forceImgStreamFallback = true;\r\n      screenTime.textContent = \"Switching to MJPEG compatibility mode…\";\r\n      autoRefreshTimer = setTimeout(startLiveStream, 500);\r\n    } else {\r\n      streamFallbackPolling = true;\r\n      screenTime.textContent = \"Live fallback (polling)\";\r\n      fetchScreenshot();\r\n    }\r\n  }\r\n\r\n  fetch(\"stream?format=bin&t=\" + Date.now(), {\r\n    signal: ctrl.signal,\r\n    cache: \"no-store\"\r\n  }).then(function (res) {\r\n    if (!res.ok || !res.body || typeof res.body.getReader !== \"function\") {\r\n      throw new Error(\"Binary stream HTTP \" + res.status);\r\n    }\r\n    var reader = res.body.getReader();\r\n    var buf = new Uint8Array(0);\r\n\r\n    function readNext() {\r\n      return reader.read().then(function (chunkRes) {\r\n        if (binStreamAbort !== ctrl) {\r\n          try { reader.cancel(); } catch (e) {}\r\n          return;\r\n        }\r\n        if (chunkRes.done) {\r\n          handleBinFailure();\r\n          return;\r\n        }\r\n        if (chunkRes.value && chunkRes.value.length > 0) {\r\n          buf = concatUint8(buf, chunkRes.value);\r\n          while (buf.length >= 8) {\r\n            var frameLen = ((buf[0] << 24) | (buf[1] << 16) | (buf[2] << 8) | buf[3]) >>> 0;\r\n            var fw = (buf[4] << 8) | buf[5];\r\n            var fh = (buf[6] << 8) | buf[7];\r\n            if (frameLen === 0 || frameLen > 4194304) {\r\n              throw new Error(\"Bad binary frame length\");\r\n            }\r\n            if (buf.length < 8 + frameLen) break;\r\n            var jpegSlice = buf.subarray(8, 8 + frameLen);\r\n            buf = buf.subarray(8 + frameLen);\r\n            canvasPendingFrame = {\r\n              blob: new Blob([jpegSlice], { type: \"image/jpeg\" }),\r\n              w: fw,\r\n              h: fh\r\n            };\r\n            pumpCanvasDecode();\r\n          }\r\n        }\r\n        return readNext();\r\n      });\r\n    }\r\n\r\n    return readNext();\r\n  }).catch(function (err) {\r\n    if (err && err.name === \"AbortError\") return;\r\n    handleBinFailure();\r\n  });\r\n}\r\n\r\nfunction startImgMjpegStream() {\r\n  abortBinStream();\r\n  if (screenCanvas) screenCanvas.style.display = \"none\";\r\n  screenImg.style.display = \"block\";\r\n  screenSpinner.style.display = \"none\";\r\n  if (screenFrame) screenFrame.classList.add(\"has-image\");\r\n  hasScreenImage = true;\r\n\r\n  var statusTimer = setTimeout(refreshCaptureStatus, 450);\r\n\r\n  screenImg.onload = function () {\r\n    clearTimeout(statusTimer);\r\n    streamFailCount = 0;\r\n    var dim = (screenImg.naturalWidth && screenImg.naturalHeight)\r\n      ? (screenImg.naturalWidth + \"×\" + screenImg.naturalHeight)\r\n      : (currentStreamWidth + \"×\" + currentStreamHeight);\r\n    screenTime.textContent = getBackendBadgeText() + \" · \" + dim + \" · Q\" + currentStreamQuality;\r\n    if (isScreenOnly) fitScreenFrame();\r\n  };\r\n  screenImg.onerror = function () {\r\n    clearTimeout(statusTimer);\r\n    if (!chkAutoRefresh || !chkAutoRefresh.checked) return;\r\n    if (document.hidden) return;\r\n    if (boxScreen.classList.contains(\"is-collapsed\") && !isScreenOnly) return;\r\n    streamFailCount++;\r\n    if (streamFailCount < 2) {\r\n      screenTime.textContent = \"Reconnecting live stream…\";\r\n      autoRefreshTimer = setTimeout(startLiveStream, 1500);\r\n    } else {\r\n      streamFallbackPolling = true;\r\n      screenImg.onerror = null;\r\n      screenImg.onload = null;\r\n      screenTime.textContent = \"Live fallback (polling)\";\r\n      fetchScreenshot();\r\n    }\r\n  };\r\n  screenImg.src = \"stream?t=\" + Date.now();\r\n}\r\n\r\nfunction startLiveStream() {\r\n  if (autoRefreshTimer) {\r\n    clearTimeout(autoRefreshTimer);\r\n    autoRefreshTimer = null;\r\n  }\r\n  screenCapturing = false;\r\n  streamFallbackPolling = false;\r\n  btnRefreshScreen.disabled = false;\r\n  btnRefreshScreen.textContent = \"🔄 Reconnect\";\r\n  screenTime.textContent = \"Connecting live stream…\";\r\n  if (supportsBinCanvas && !forceImgStreamFallback) {\r\n    startBinCanvasStream();\r\n  } else {\r\n    startImgMjpegStream();\r\n  }\r\n  if (isScreenOnly) fitScreenFrame();\r\n}\r\n\r\nfunction stopLiveStream(keepSnapshot) {\r\n  if (autoRefreshTimer) {\r\n    clearTimeout(autoRefreshTimer);\r\n    autoRefreshTimer = null;\r\n  }\r\n  abortBinStream();\r\n  streamFailCount = 0;\r\n  streamFallbackPolling = false;\r\n  currentLiveFps = 0;\r\n  btnRefreshScreen.disabled = false;\r\n  btnRefreshScreen.textContent = \"🔄 Capture / Refresh\";\r\n  screenImg.onerror = null;\r\n  screenImg.onload = null;\r\n  if (keepSnapshot && hasScreenImage) {\r\n    fetchScreenshot();\r\n    screenTime.textContent = \"Stream paused\";\r\n  } else {\r\n    hasScreenImage = false;\r\n    screenImg.src = \"\";\r\n    screenImg.style.display = \"none\";\r\n    if (screenCanvas) screenCanvas.style.display = \"none\";\r\n    if (screenFrame) screenFrame.classList.remove(\"has-image\");\r\n    if (!keepSnapshot) screenTime.textContent = \"\";\r\n  }\r\n}\r\n\r\ndocument.addEventListener(\"visibilitychange\", function () {\r\n  if (!chkAutoRefresh || !chkAutoRefresh.checked) return;\r\n  if (document.hidden) {\r\n    if (autoRefreshTimer) {\r\n      clearTimeout(autoRefreshTimer);\r\n      autoRefreshTimer = null;\r\n    }\r\n    abortBinStream();\r\n    screenImg.onerror = null;\r\n    screenImg.onload = null;\r\n    screenImg.src = \"\";\r\n    screenTime.textContent = \"Stream paused (tab hidden)\";\r\n  } else if (!boxScreen.classList.contains(\"is-collapsed\") || isScreenOnly) {\r\n    startLiveStream();\r\n  }\r\n});\r\n\r\nwindow.addEventListener(\"pagehide\", function () {\r\n  if (chkAutoRefresh && chkAutoRefresh.checked) {\r\n    abortBinStream();\r\n    screenImg.onerror = null;\r\n    screenImg.onload = null;\r\n    screenImg.src = \"\";\r\n  }\r\n});\r\n\r\nfunction fetchScreenshot() {\r\n  if (chkAutoRefresh && chkAutoRefresh.checked && !streamFallbackPolling) {\r\n    startLiveStream();\r\n    return;\r\n  }\r\n  if (screenCapturing) return;\r\n  screenCapturing = true;\r\n  if (!hasScreenImage) {\r\n    screenSpinner.textContent = \"Capturing 1080p screen from TV…\";\r\n    screenSpinner.style.display = \"block\";\r\n  } else {\r\n    screenTime.textContent = streamFallbackPolling ? \"Live fallback (polling)\" : \"Capturing 1080p…\";\r\n  }\r\n  btnRefreshScreen.disabled = true;\r\n  btnRefreshScreen.textContent = \"⏳ Capturing…\";\r\n\r\n  var img = new Image();\r\n  var url = \"screenshot?t=\" + Date.now();\r\n  img.onload = function () {\r\n    streamFailCount = 0;\r\n    hasScreenImage = true;\r\n    if (screenCanvas) screenCanvas.style.display = \"none\";\r\n    screenImg.onerror = null;\r\n    screenImg.onload = null;\r\n    screenImg.src = url;\r\n    screenImg.style.display = \"block\";\r\n    if (screenFrame) screenFrame.classList.add(\"has-image\");\r\n    screenSpinner.style.display = \"none\";\r\n    screenCapturing = false;\r\n    btnRefreshScreen.disabled = false;\r\n    btnRefreshScreen.textContent = (chkAutoRefresh && chkAutoRefresh.checked) ? \"🔄 Reconnect\" : \"🔄 Capture / Refresh\";\r\n    var d = new Date();\r\n    var pad = function (n) { return (n < 10 ? \"0\" : \"\") + n; };\r\n    var resLabel = (img.naturalWidth && img.naturalHeight) ? (img.naturalWidth + \"×\" + img.naturalHeight + \" \") : \"\";\r\n    screenTime.textContent = streamFallbackPolling\r\n      ? (\"Live fallback · \" + resLabel + pad(d.getHours()) + \":\" + pad(d.getMinutes()) + \":\" + pad(d.getSeconds()))\r\n      : (\"Captured \" + resLabel + \"at \" + pad(d.getHours()) + \":\" + pad(d.getMinutes()) + \":\" + pad(d.getSeconds()));\r\n    if (isScreenOnly) fitScreenFrame();\r\n\r\n    if (chkAutoRefresh && chkAutoRefresh.checked && streamFallbackPolling && (!boxScreen.classList.contains(\"is-collapsed\") || isScreenOnly) && !document.hidden) {\r\n      autoRefreshTimer = setTimeout(fetchScreenshot, 2500);\r\n    }\r\n  };\r\n  img.onerror = function () {\r\n    if (!hasScreenImage) {\r\n      screenSpinner.textContent = \"Failed to capture screen from TV\";\r\n    } else {\r\n      screenTime.textContent = \"Refresh failed — retrying\";\r\n    }\r\n    screenCapturing = false;\r\n    btnRefreshScreen.disabled = false;\r\n    btnRefreshScreen.textContent = (chkAutoRefresh && chkAutoRefresh.checked) ? \"🔄 Reconnect\" : \"🔄 Capture / Refresh\";\r\n\r\n    if (chkAutoRefresh && chkAutoRefresh.checked && streamFallbackPolling && (!boxScreen.classList.contains(\"is-collapsed\") || isScreenOnly) && !document.hidden) {\r\n      autoRefreshTimer = setTimeout(fetchScreenshot, 4000);\r\n    }\r\n  };\r\n  img.src = url;\r\n}\r\n\r\nfunction toggleScreenCollapse(e) {\r\n  if (e && e.target && (e.target.closest(\"#link-standalone\") || e.target.closest(\"#btn-enter-theater\"))) return;\r\n  var collapsed = boxScreen.classList.toggle(\"is-collapsed\");\r\n  btnToggleScreen.setAttribute(\"aria-expanded\", collapsed ? \"false\" : \"true\");\r\n  if (collapsed) {\r\n    if (chkAutoRefresh && chkAutoRefresh.checked) {\r\n      stopLiveStream(false);\r\n    } else if (autoRefreshTimer) {\r\n      clearTimeout(autoRefreshTimer);\r\n      autoRefreshTimer = null;\r\n    }\r\n  } else {\r\n    if (chkAutoRefresh && chkAutoRefresh.checked) {\r\n      startLiveStream();\r\n    } else if (!hasScreenImage) {\r\n      fetchScreenshot();\r\n    }\r\n  }\r\n}\r\n\r\nif (location.hash === \"#screen\") {\r\n  setScreenOnlyMode(true, false);\r\n}\r\n\r\nif (btnToggleScreen && boxScreen) {\r\n  btnToggleScreen.addEventListener(\"click\", function (e) {\r\n    e.stopPropagation();\r\n    toggleScreenCollapse();\r\n  });\r\n  if (screenHeader) {\r\n    screenHeader.addEventListener(\"click\", toggleScreenCollapse);\r\n  }\r\n}\r\n\r\nif (chkHoverOnly) {\r\n  chkHoverOnly.onchange = function () {\r\n    chkHoverOnly.blur();\r\n  };\r\n}\r\n\r\nif (chkAutoRefresh) {\r\n  chkAutoRefresh.onchange = function () {\r\n    updateStreamQualityVisibility();\r\n    if (chkAutoRefresh.checked) {\r\n      startLiveStream();\r\n    } else {\r\n      stopLiveStream(true);\r\n    }\r\n    chkAutoRefresh.blur();\r\n  };\r\n}\r\nupdateStreamQualityVisibility();\r\n\r\nbtnRefreshScreen.onclick = function () {\r\n  if (chkAutoRefresh && chkAutoRefresh.checked) {\r\n    streamFailCount = 0;\r\n    startLiveStream();\r\n  } else {\r\n    fetchScreenshot();\r\n  }\r\n};\r\n\r\nif (!isTouch) {\r\n  ti.focus();\r\n}\r\n</script>\r\n</body>\r\n</html>\r\n"}}
